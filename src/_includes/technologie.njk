---
layout: base.njk
---
<!-- HERO INTERNE -->
<div class="hero-interne">
  <div class="container">
    <nav class="fil-ariane" aria-label="Fil d'Ariane"><a href="/">Accueil</a> &rsaquo; <a href="/expertises-techniques/">Expertises techniques</a> &rsaquo; {{ nom }}</nav>
    <div class="hero-grille">
      <div>
        <p class="eyebrow">Expertise technique</p>
        <h1>{{ h1 | accent | safe }}</h1>
        <p class="chapo" style="font-size:18px;color:var(--texte-2);margin-bottom:26px">{{ intro }}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/contact/">Contactez-nous</a>
          {% if formations and formations.length %}<a class="btn btn-ghost" href="#formations">Nos formations</a>{% endif %}
        </div>
      </div>
      {% if logo %}
      <div class="techno-blason" aria-hidden="true">
        <img src="{{ logo }}" alt="{{ nom }}" loading="eager" decoding="async">
      </div>
      {% endif %}
    </div>
  </div>
</div>

<!-- POURQUOI -->
<section>
  <div class="container">
    <p class="eyebrow">{{ pourquoi_eyebrow or ("Pourquoi " + nom + " ?") }}</p>
    {% if pourquoi_titre %}<h2 class="sec-titre">{{ pourquoi_titre | accent | safe }}</h2>{% endif %}
    {% if pourquoi_intro %}<p class="sec-sous">{{ pourquoi_intro }}</p>{% endif %}
    <div class="atouts" style="grid-template-columns:repeat(4,1fr)">
      {% for a in atouts %}
      <div class="atout"><span class="n">{{ loop.index }}</span><h3>{{ a.titre }}</h3><p>{{ a.texte }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- RÉFÉRENCES CLIENTS -->
{% if references and references.length %}
<section style="padding-top:0">
  <div class="container">
    <p class="eyebrow">Références clients</p>
    <div class="sect-refs-inline">
      {% for r in references %}
      {% set fiche = collections.references | ficheRef(r.lien) %}
      <div class="sect-ref-carte">
        {% if fiche and fiche.data.image %}
        <div class="sect-ref-visuel">
          <img src="{{ fiche.data.image }}" alt="{{ fiche.data.titre }}" loading="lazy" decoding="async">
          <div class="ref-cartouche">{% if fiche.data.logo %}<img src="{{ fiche.data.logo }}" alt="{{ fiche.data.client }}" loading="lazy" decoding="async">{% else %}<span class="ref-cartouche-txt">{{ fiche.data.client }}</span>{% endif %}</div>
        </div>
        {% else %}
        <div class="sect-ref-visuel ref-visuel--vide"><span class="ref-vide-nom">{{ (fiche.data.client if fiche else r.titre.split(" - ")[0]) }}</span></div>
        {% endif %}
        <div class="sect-ref-corps">
          <span class="sect-ref-label">{% if fiche and fiche.data.secteurs and fiche.data.secteurs.length %}{{ fiche.data.secteurs[0] }}{% else %}Projet{% endif %}</span>
          <h3>{{ r.titre }}</h3>
          <div class="sect-ref-texte"><p>{{ r.texte }}</p></div>
          {% if r.lien %}<a class="socle-lien" href="{{ r.lien }}">Voir la référence &rarr;</a>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- CORPS MARKDOWN (communauté, écosystème, guide technologie) -->
{% if content %}
{% if corps_sombre %}
<section class="section-sombre sur-sombre">
  <div class="container">
    <p class="eyebrow">{{ corps_eyebrow or "Communauté et écosystème" }}</p>
    {% if corps_titre %}<h2 class="sec-titre">{{ corps_titre | accent | safe }}</h2>{% endif %}
    <div class="prose prose--sombre">{{ content | safe }}</div>
  </div>
</section>
{% else %}
<section style="padding-bottom:0">
  <div class="container">
    <p class="eyebrow">{{ corps_eyebrow or "Communauté et écosystème" }}</p>
    {% if corps_titre %}<h2 class="sec-titre">{{ corps_titre | accent | safe }}</h2>{% endif %}
  </div>
</section>
{{ content | blocs | safe }}
{% endif %}
{% endif %}

<!-- NOS FORMATIONS -->
{% if formations and formations.length %}
<section id="formations">
  <div class="container">
    <p class="eyebrow">Nos formations</p>
    <div class="socle" style="grid-template-columns:repeat(3,1fr)">
      {% for f in formations %}
      <a class="socle-carte" href="{{ f.url or '#' }}"><h3>{{ f.titre }}</h3><span class="socle-lien">Découvrir →</span></a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if faq and faq.length %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for item in faq %}
    {
      "@type": "Question",
      "name": {{ item.question | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ item.reponse | dump | safe }} }
    }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
<section style="background:var(--creme)">
  <div class="container">
    <div class="sect-faq" style="max-width:820px;margin:0 auto">
      <h2 class="sec-titre">{{ (faq_titre or ("Questions fréquentes sur " + nom)) | accent | safe }}</h2>
      <div class="faq" style="margin-top:20px">
        {% for item in faq %}
        <details{% if loop.first %} open{% endif %}>
          <summary>{{ item.question }}</summary>
          <p>{{ item.reponse }}</p>
        </details>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

{% include "contact-etendu.njk" %}
