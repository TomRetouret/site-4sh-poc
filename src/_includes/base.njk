{%- from "composants/en-tete.njk" import en_tete -%}
{%- from "composants/pied-de-page.njk" import pied_de_page -%}
{%- if lang == "en" -%}{% set navigation = en.navigation %}{% set site = en.site %}{% set seo = en.seo %}{%- endif -%}
{%- set offre = offre or ("build" if famille_label == "Concevoir & développer" else ("run" if famille_label == "Faire vivre & auditer" else ("learning" if bodyClass == "learning" else ""))) -%}
{%- set u = page.url or "" -%}
{#- Rubrique active (losange du menu) : d'abord l'entrée du menu qui contient l'adresse exacte de la page
    (lien, page mère de colonne ou sous-lien), sinon par préfixe d'adresse. -#}
{%- set rubriques_trouvees = [] -%}
{%- for item in navigation.items -%}
  {%- set adresses = [item.url] -%}
  {%- for l in item.liens or [] %}{% set _x = adresses.push(l.url) %}{% endfor -%}
  {%- for col in item.colonnes or [] -%}
    {%- set _x = adresses.push(col.url) -%}
    {%- for l in col.liens or [] %}{% set _x = adresses.push(l.url) %}{% endfor -%}
  {%- endfor -%}
  {%- if u in adresses %}{% set _x = rubriques_trouvees.push(item.label) %}{% endif -%}
{%- endfor -%}
{%- set rubrique = rubriques_trouvees[0] or "" -%}
{%- if rubrique -%}
{%- elif u.startsWith("/prestations/") or u.startsWith("/intelligence-artificielle") -%}{% set rubrique = "Prestations & IA" %}
{%- elif u.startsWith("/secteurs/") -%}{% set rubrique = "Secteurs" %}
{%- elif u.startsWith("/expertises-techniques") -%}{% set rubrique = "Expertises" %}
{%- elif u.startsWith("/references/") -%}{% set rubrique = "Réalisations" %}
{%- elif u.startsWith("/notre-") -%}{% set rubrique = "L'agence" %}
{%- elif u.startsWith("/formations/") -%}{% set rubrique = "Formations" %}
{%- endif %}
<!DOCTYPE html>
<html lang="{{ lang or 'fr' }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title or seo.titre_defaut }}</title>
<meta name="description" content="{{ description or seo.description_defaut }}">
<link rel="canonical" href="{{ seo.url }}{{ page.url }}">
{% if altUrl %}<link rel="alternate" hreflang="{{ lang or 'fr' }}" href="{{ seo.url }}{{ page.url }}">
<link rel="alternate" hreflang="{{ 'fr' if lang == 'en' else 'en' }}" href="{{ seo.url }}{{ altUrl }}">
<link rel="alternate" hreflang="x-default" href="{{ seo.url }}{{ altUrl if lang == 'en' else page.url }}">{% endif %}
{% if noindex or not seo.indexation %}<meta name="robots" content="noindex, nofollow">{% endif %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="4SH">
<meta property="og:title" content="{{ title or seo.titre_defaut }}">
<meta property="og:description" content="{{ description or seo.description_defaut }}">
<meta property="og:url" content="{{ seo.url }}{{ page.url }}">
<meta property="og:image" content="{{ seo.og_image }}">
<meta name="twitter:card" content="summary_large_image">
{# Polices auto-hébergées (src/assets/polices.css, fichiers sous src/assets/polices/) : aucun appel
   à Google Fonts. Pour une éventuelle politique de contenu (CSP, netlify.toml) : font-src 'self' et
   style-src 'self' suffisent pour les polices ; fonts.googleapis.com et fonts.gstatic.com ne sont plus
   nécessaires. Les deux préchargements (Asap 400, Manrope 800) gardent l'attribut crossorigin, exigé
   pour les polices même servies par le site. -#}
<link rel="preload" href="/assets/polices/asap-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/polices/manrope-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/polices.css">
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Organization","name":"4SH","url":"https://www.4sh.fr/","foundingDate":"2007","address":[{"@type":"PostalAddress","addressLocality":"Le Haillan","postalCode":"33185"},{"@type":"PostalAddress","addressLocality":"Capbreton","postalCode":"40130"},{"@type":"PostalAddress","addressLocality":"Paris","postalCode":"75008"}],"telephone":"+33963286273"}
</script>
<link rel="stylesheet" href="/assets/styles.css">
{% if learningStyles %}<link rel="stylesheet" href="/assets/learning.css">{% endif %}
{% if catalogueStyles %}<link rel="stylesheet" href="/assets/catalogue.css">{% endif %}
{% if extraCss %}<link rel="stylesheet" href="{{ extraCss }}">{% endif %}
<link rel="stylesheet" href="/assets/charte.css">
<link rel="stylesheet" href="/assets/mouvement.css">
</head>
<body class="{{ bodyClass }}{% if offre %} famille-{{ 'formation' if offre == 'learning' else offre }}{% endif %}">

{% if not hideHeader %}
{{ en_tete(navigation, rubrique, lang, altUrl, page.url) }}
{% endif %}

{{ content | safe }}

{{ pied_de_page(site, page.url) }}

<script src="/assets/script.js"></script>
<script src="/assets/mouvement.js"></script>
<script src="/assets/formulaires.js" defer></script>
</body>
</html>
