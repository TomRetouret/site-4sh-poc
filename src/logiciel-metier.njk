---
layout: base.njk
permalink: /logiciel-metier/
extraCss: /assets/logiciel-metier.css
---
{%- set lm = logiciel_metier -%}

<!-- HERO INTERNE -->
<div class="hero-interne">
  <div class="container">
    <nav class="fil-ariane" aria-label="Fil d'Ariane"><a href="/">Accueil</a> &rsaquo; <a href="#">Développement sur mesure</a> &rsaquo; Logiciel métier</nav>
    <div class="hero-grille">
      <div>
        <h1>{{ lm.hero_h1 | accent | safe }}</h1>
        <p class="chapo" style="font-size:18px;color:var(--texte-2);margin-bottom:26px">{{ lm.hero_chapo }}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="{{ lm.hero_cta_principal_url or '#contact' }}">{{ lm.hero_cta_principal_label }}</a>
          <a class="btn btn-ghost" href="{{ lm.hero_cta_secondaire_url or '#realisations' }}">{{ lm.hero_cta_secondaire_label }}</a>
        </div>
        <div class="chips">
          {% for chip in lm.hero_chips %}<span>{{ chip }}</span>{% endfor %}
        </div>
      </div>
      <div class="schema-craft" aria-hidden="true">
        <svg viewBox="0 0 480 270" fill="none" font-family="Asap,sans-serif">
          <rect x="18" y="26" width="130" height="66" rx="12" stroke="#494849" stroke-width="1.6"/>
          <text x="83" y="55" text-anchor="middle" fill="#1f292e" font-size="15" font-weight="600">Votre besoin</text>
          <text x="83" y="76" text-anchor="middle" fill="#767676" font-size="12">process, terrain, contraintes</text>
          <rect x="178" y="118" width="130" height="66" rx="12" stroke="#494849" stroke-width="1.6"/>
          <text x="243" y="147" text-anchor="middle" fill="#1f292e" font-size="15" font-weight="600">Ateliers &#38; maquettes</text>
          <text x="243" y="168" text-anchor="middle" fill="#767676" font-size="12">testés avec vos équipes</text>
          <rect x="332" y="26" width="130" height="66" rx="12" stroke="#ea2631" stroke-width="1.8"/>
          <text x="397" y="55" text-anchor="middle" fill="#1f292e" font-size="15" font-weight="600">Votre logiciel</text>
          <text x="397" y="76" text-anchor="middle" fill="#767676" font-size="12">évolutif, maintenu</text>
          <path d="M118 96c18 26 34 38 56 46" stroke="#494849" stroke-width="1.6" stroke-linecap="round"/>
          <path d="M164 136l10 7-12 4" stroke="#494849" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M312 146c26-8 44-24 58-46" stroke="#494849" stroke-width="1.6" stroke-linecap="round"/>
          <path d="M362 106l8-8 3 12" stroke="#494849" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <text x="240" y="228" text-anchor="middle" fill="#ea2631" font-size="17" font-family="Fraunces,Georgia,serif" font-style="italic">du terrain à votre logiciel</text>
          <path d="M290 240c10 6 24 6 38-2" stroke="#ea2631" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </div>
    </div>
  </div>
</div>

<!-- PREUVE CHIFFRÉE -->
<section style="padding:0">
  <div class="chiffres">
    <div class="container">
      {% for c in lm.chiffres %}
      <div><b{% if c.compte %} data-compte="{{ c.compte }}"{% if c.suffixe %} data-suffixe="{{ c.suffixe }}"{% endif %}{% endif %}>{{ c.valeur }}</b><span>{{ c.texte }}</span>{% if c.note %}<small>{{ c.note }}</small>{% endif %}</div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- POURQUOI OPTER -->
<section>
  <div class="container">
    <p class="eyebrow">{{ lm.pourquoi_eyebrow }}</p>
    <h2 class="sec-titre">{{ lm.pourquoi_titre | accent | safe }}</h2>
    <div class="prose">
      {% for p in lm.pourquoi_paragraphes %}<p>{{ p | accent | safe }}</p>{% endfor %}
    </div>
  </div>
</section>

<!-- ACCOMPAGNEMENT -->
<section style="padding-top:0">
  <div class="container">
    <p class="eyebrow">{{ lm.methode_eyebrow }}</p>
    <h2 class="sec-titre">{{ lm.methode_titre | accent | safe }}</h2>
    <p class="sec-sous">{{ lm.methode_sous }}</p>
    <div class="etapes cinq">
      {% for e in lm.methode_etapes %}
      <div class="etape"><span class="num">{{ e.num }}</span><span class="num-label">{{ e.label }}</span><h3>{{ e.titre }}</h3><p>{{ e.texte }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- SOCLE TECHNOLOGIQUE -->
<section class="section-sombre">
  <div class="container">
    <p class="eyebrow">{{ lm.socle_eyebrow }}</p>
    <h2 class="sec-titre">{{ lm.socle_titre | accent | safe }}</h2>
    <p class="sec-sous">{{ lm.socle_sous }}</p>
    <div class="socle">
      {% for s in lm.socle_cartes %}
      <div class="socle-carte">{% if s.logo %}<img src="{{ s.logo }}" alt="{{ s.nom }}">{% endif %}<h3>{{ s.nom }}</h3><a href="{{ s.lien_url or '#' }}">{{ s.lien_label }}</a></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- POUR QUI -->
<section>
  <div class="container">
    <p class="eyebrow">{{ lm.pour_qui_eyebrow }}</p>
    <h2 class="sec-titre">{{ lm.pour_qui_titre | accent | safe }}</h2>
    <div class="prose">
      {% for p in lm.pour_qui_paragraphes %}<p>{{ p | accent | safe }}</p>{% endfor %}
    </div>
  </div>
</section>

<!-- POURQUOI 4SH -->
<section style="padding-top:0">
  <div class="container">
    <p class="eyebrow">{{ lm.atouts_eyebrow }}</p>
    <h2 class="sec-titre">{{ lm.atouts_titre | accent | safe }}</h2>
    <p class="sec-sous">{{ lm.atouts_sous }}</p>
    <div class="atouts">
      {% for a in lm.atouts %}
      <div class="atout"><span class="n">{{ loop.index }}</span><h3>{{ a.titre }}</h3><p>{{ a.texte }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- REALISATIONS -->
<section style="padding-top:0" id="realisations">
  <div class="container">
    <p class="eyebrow">{{ lm.realisations_eyebrow }}</p>
    <h2 class="sec-titre">{{ lm.realisations_titre | accent | safe }}</h2>
    {% set v = lm.realisations_vedette %}
    <div class="cas" style="margin-top:24px;margin-bottom:22px">
      <div class="cas-visuel">
        <div class="secteur">{{ v.secteur }}</div>
        <div class="logo-client">{{ v.logo_texte }}</div>
        <p style="color:#b9c3c8;font-size:15px">{{ v.description }}</p>
      </div>
      <div class="cas-corps">
        {% if v.citation %}<blockquote>{{ v.citation }}</blockquote>{% if v.auteur %}<p class="auteur">{{ v.auteur }}</p>{% endif %}{% endif %}
        <div class="cas-chiffre">
          {% for ch in v.chiffres %}<div><b>{{ ch.valeur | accent | safe }}</b><span>{{ ch.label }}</span></div>{% endfor %}
        </div>
        <a class="btn btn-ghost btn-sm" href="{{ v.cta_url or '#' }}">{{ v.cta_label }}</a>
      </div>
    </div>
    <div class="realisations">
      {% for r in lm.realisations_cartes %}
      <div class="real-carte">
        <div class="secteur">{{ r.secteur }}</div>
        <h3>{{ r.titre }}</h3>
        <p>{{ r.texte }}</p>
        <a href="{{ r.url or '#' }}">Voir la référence →</a>
      </div>
      {% endfor %}
    </div>
    <div class="clients">
      <p class="tt">{{ lm.realisations_clients_titre }}</p>
      <div class="marquee"><ul>{% for c in lm.realisations_clients %}<li>{{ c }}</li>{% endfor %}</ul></div>
    </div>
  </div>
</section>

<!-- BLOG -->
<section style="padding-top:0">
  <div class="container">
    <p class="eyebrow">{{ lm.blog_eyebrow }}</p>
    <h2 class="sec-titre">{{ lm.blog_titre | accent | safe }}</h2>
    <div class="blog-grille">
      {% for a in lm.blog_articles %}
      <article class="blog-carte">
        <div class="blog-meta"><span class="tag">{{ a.tag }}</span> &middot; {{ a.date }} &middot; {{ a.duree }}</div>
        <h3><a href="{{ a.url or '#' }}">{{ a.titre }}</a></h3>
        <div class="blog-auteur">{{ a.auteur }}</div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<!-- FAQ -->
<section style="padding-top:0">
  <div class="container">
    <h2 class="sec-titre" style="text-align:center">{{ lm.faq_titre | accent | safe }}</h2>
    <p class="sec-sous" style="margin:0 auto 38px;text-align:center">{{ lm.faq_sous }}</p>
    <div class="faq">
      {% for item in lm.faq %}
      <details{% if loop.first %} open{% endif %}>
        <summary>{{ item.question }}</summary>
        <p>{{ item.reponse }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

<!-- CONTACT FINAL (bloc mutualisé, piloté par Réglages du site) -->
{% include "contact-etendu.njk" %}

<a class="btn btn-primary sticky-cta" href="#contact">{{ lm.sticky_cta_label }}</a>
