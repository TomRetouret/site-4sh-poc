{#
  AIGUILLEUR DES BLOCS (page d'accueil)
  Spécification : docs/back-office/schema-blocs.md

  rendre_blocs(blocs, site, blog, temoignages, url_page)
    blocs       : la liste "blocs" du fichier src/_data/contenus/<langue>/accueil.json
    site        : le bundle site de la langue
    blog        : les derniers articles, ou rien
    temoignages : la collection de la langue (temoignages.fr, temoignages.en), ou rien
    url_page    : page.url, pour le formulaire de contact

  Parcourt les blocs dans l'ordre, ignore ceux marqués "masquer", appelle le
  composant du type, puis ajoute le formulaire de contact final (hors blocs).
  Référence et retour arrière : composants/pages/accueil.njk (ancien rendu).
#}
{% from "composants/blocs/hero.njk" import bloc as bloc_hero %}
{% from "composants/blocs/logos_clients.njk" import bloc as bloc_logos_clients %}
{% from "composants/blocs/cartes_offres.njk" import bloc as bloc_cartes_offres %}
{% from "composants/blocs/chiffres_cles.njk" import bloc as bloc_chiffres_cles %}
{% from "composants/blocs/cartes_secteurs.njk" import bloc as bloc_cartes_secteurs %}
{% from "composants/blocs/methode_4d.njk" import bloc as bloc_methode_4d %}
{% from "composants/blocs/projets.njk" import bloc as bloc_projets %}
{% from "composants/blocs/technologies.njk" import bloc as bloc_technologies %}
{% from "composants/blocs/faq.njk" import bloc as bloc_faq %}
{% from "composants/blocs/derniers_articles.njk" import bloc as bloc_derniers_articles %}
{% from "composants/blocs/equipe.njk" import bloc as bloc_equipe %}
{% from "composants/formulaires.njk" import contact_final as bloc_contact %}

{% macro rendre_blocs(blocs, site, blog, temoignages, url_page) %}
{# étapes du hero : premier bloc methode_4d de la page, même masqué #}
{% set m4d = blocs | premierBloc("methode_4d") %}
{% set ctx = {
  site: site,
  blog: blog,
  temoignages: temoignages,
  etapes_4d: (m4d.etapes if m4d else []),
  url_page: url_page
} %}
{% for b in blocs %}
{% if not b.masquer %}
{% if b.type == "hero" %}{{ bloc_hero(b, ctx) }}
{% elif b.type == "logos_clients" %}{{ bloc_logos_clients(b, ctx) }}
{% elif b.type == "cartes_offres" %}{{ bloc_cartes_offres(b, ctx) }}
{% elif b.type == "chiffres_cles" %}{{ bloc_chiffres_cles(b, ctx) }}
{% elif b.type == "cartes_secteurs" %}{{ bloc_cartes_secteurs(b, ctx) }}
{% elif b.type == "methode_4d" %}{{ bloc_methode_4d(b, ctx) }}
{% elif b.type == "projets" %}{{ bloc_projets(b, ctx) }}
{% elif b.type == "technologies" %}{{ bloc_technologies(b, ctx) }}
{% elif b.type == "faq" %}{{ bloc_faq(b, ctx) }}
{% elif b.type == "derniers_articles" %}{{ bloc_derniers_articles(b, ctx) }}
{% elif b.type == "equipe" %}{{ bloc_equipe(b, ctx) }}
{% endif %}
{% endif %}
{% endfor %}

<!-- CONTACT FINAL (bloc étendu mutualisé) -->
{{ bloc_contact(site, url_page) }}
{% endmacro %}
