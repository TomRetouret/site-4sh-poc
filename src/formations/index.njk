---
layout: base.njk
bodyClass: learning
learningStyles: true
catalogueStyles: true
permalink: /formations/
---
<div class="hero-form">
  <div class="container">
    <nav class="fil-ariane" aria-label="Fil d'Ariane"><a href="/">Accueil</a> › Formations en informatique</nav>
    <div class="hero-grille">
      <div>
        <span class="eyebrow">{{ page_formations.eyebrow }}</span>
        <h1>{{ page_formations.h1 | safe }}</h1>
        <p class="chapo">{{ page_formations.chapo }}</p>
        <div class="meta-form">
          <span class="note-etoiles"><span class="etoiles">★★★★★</span> {{ page_formations.note }} <small>· {{ page_formations.note_detail }}</small></span>
        </div>
        <div class="hero-cta">
          <a class="btn btn-learning" href="#catalogue">Découvrir les formations</a>
          <a class="btn btn-ghost" href="#contact" style="border-color:var(--violet);color:var(--violet)">Devis sur mesure</a>
        </div>
      </div>
      <div class="visuel-form">
        <img src="https://www.4sh.fr/assets/img/svg/illu-learning.svg" alt="4SH Learning, formations en informatique">
        <div class="chips" style="justify-content:center"><span>Présentiel &amp; distanciel</span><span>Certifié Qualiopi</span></div>
      </div>
    </div>
  </div>
</div>

<!-- POURQUOI CHOISIR 4SH LEARNING -->
<section style="padding:80px 0 0">
  <div class="container">
    <h2 class="sec-titre">{{ page_formations.pourquoi_titre | safe }}</h2>
    <div class="portes" style="margin-top:44px">
      <div class="porte">
        <div class="pictos"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></div>
        <h3>{{ page_formations.pourquoi[0].titre }}</h3>
        <p>{{ page_formations.pourquoi[0].texte }}</p>
      </div>
      <div class="porte">
        <div class="pictos"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
        <h3>{{ page_formations.pourquoi[1].titre }}</h3>
        <p>{{ page_formations.pourquoi[1].texte }}</p>
      </div>
      <div class="porte">
        <div class="pictos"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9M3 20h2M12 4v16M4 4h16v10H4z"/></svg></div>
        <h3>{{ page_formations.pourquoi[2].titre }}</h3>
        <p>{{ page_formations.pourquoi[2].texte }}</p>
      </div>
    </div>
  </div>
</section>

<!-- CATALOGUE + RECHERCHE + FILTRES -->
<section id="catalogue" style="padding-top:80px">
  <div class="container">
    <h2 class="sec-titre">Catalogue de <em class="accent">formations</em></h2>
    <p class="sec-sous">Cherchez une technologie ou choisissez une catégorie.</p>
    {% include "catalogue-grille.njk" %}
  </div>
</section>

<!-- AGENDA / PROCHAINES SESSIONS -->
