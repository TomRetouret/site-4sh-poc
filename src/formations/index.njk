        <div class="date-bloc"><div class="jour">13</div><div class="mois">Oct.</div><div class="duree">4 jours</div></div>
        <div class="session-info">
          <span class="logo-mini"><img src="https://www.4sh.fr/assets/img/svg/trainings/logo-technos/java.svg" alt="Java"></span>
          <div>
            <b>Java - Fondamental <span class="pastille-cat">Develop</span></b>
            <div class="details"><span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> Bordeaux</span><span>Présentiel &amp; distanciel</span></div>
