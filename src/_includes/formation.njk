---
layout: base.njk
bodyClass: learning
learningStyles: true
permalink: "/formations/{{ page.fileSlug }}/"
---
{% from "composants/formulaires.njk" import devis, case_rgpd %}
<!-- HERO DÉTAIL + CARTE INSCRIPTION (colonne latérale sticky sur tout le scroll) -->
<div class="hero-detail">
  <div class="container">
    <nav class="fil-ariane" aria-label="Fil d'Ariane"><a href="/">Accueil</a> › <a href="/formations/">Formations</a> › <a href="/formations/">{{ categorie }}</a> › Formation {{ titre }}{% if sous_titre %} {{ sous_titre }}{% endif %}</nav>

    <div class="detail-tete">
      <span class="eyebrow">{{ libelles.formation.eyebrow }}{{ categorie }}</span>
      <h1>Formation {{ titre }}{% if sous_titre %} <em class="accent">{{ sous_titre }}</em>{% endif %}</h1>
      <p class="chapo">{{ chapo }}</p>
    </div>

    <div class="detail-grille">

      <!-- colonne droite : carte inscription (déclarée avant pour l'ordre mobile) -->
      <aside class="detail-aside">
        <div class="aside-colle">
        <div class="carte-inscription">
          <div class="prix-bloc">
            <div class="sessions" style="margin-bottom:6px">{{ libelles.formation.prix_titre }}</div>
            <div class="montant">{{ prix }}</div>
            <div class="par">{{ libelles.formation.par_participant }}</div>
            <div class="promo">{{ libelles.formation.promo | accent | safe }}</div>
          </div>
          {% if sessions and sessions.length %}
          <div class="sessions">{{ libelles.formation.sessions_titre }}</div>
          {% for s in sessions %}
          <div class="session">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M3 5H21V21H3Z"/><path d="M3 10H21M8 3V7M16 3V7"/></svg>
            {{ s }}
          </div>
          {% endfor %}
          {% endif %}
          <a class="btn btn-learning" href="#" onclick="ouvrirModale();return false;">{{ libelles.formation.cta_inscription }}</a>
          <a class="btn btn-ghost" href="#devis" style="width:100%;justify-content:center;border-color:var(--violet);color:var(--violet)">{{ libelles.formation.cta_devis }}</a>
          <p class="note-lieu">{{ libelles.formation.note_lieu }}</p>
        </div>

        {% if programme_pdf or site.documents.qualiopi_url or site.documents.cgv_url %}
        <div class="carte-inscription" style="margin-top:16px">
          <div class="sessions">{{ libelles.formation.documents_titre }}</div>
          <ul style="list-style:none;padding:0;margin:8px 0 0;font-size:14.5px;line-height:1.9">
            {% if programme_pdf %}<li><a href="{{ programme_pdf }}" target="_blank" rel="noopener">{{ libelles.formation.programme_pdf_label }}{% if programme_pdf_poids %} (PDF, {{ programme_pdf_poids }}){% endif %}</a></li>{% endif %}
            {% if site.documents.qualiopi_url %}<li><a href="{{ site.documents.qualiopi_url }}" target="_blank" rel="noopener">{{ site.documents.qualiopi_label }}</a></li>{% endif %}
            {% if site.documents.cgv_url %}<li><a href="{{ site.documents.cgv_url }}" target="_blank" rel="noopener">{{ site.documents.cgv_label }}</a></li>{% endif %}
          </ul>
        </div>
        {% endif %}
        </div>
      </aside>

      <!-- colonne gauche : caractéristiques + tout le contenu de la fiche -->
      <div class="detail-main">

        {% for grp in collections.formationsParGroupe %}{% if grp.groupe == groupe and grp.niveaux.length > 1 %}
        <nav class="toggle-niveau" aria-label="Niveau de la formation">
          {% for n in grp.niveaux %}<a{% if n.url == page.url %} class="actif" aria-current="page"{% else %} href="{{ n.url }}"{% endif %}>{{ n.niveau }}</a>{% endfor %}
        </nav>
        {% endif %}{% endfor %}

        <div class="meta-grille">
          {% if duree %}<div class="meta-item"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M8 3H16L21 8V16L16 21H8L3 16V8Z"/><path d="M12 7V12H16"/></svg><span>{{ duree | accent | safe }}</span></div>{% endif %}
          {% if participants %}<div class="meta-item"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M6 3H12V9H6Z"/><path d="M3 21V14H15V21"/><path d="M16 5H20V9H16Z"/><path d="M18 13H21V21"/></svg><span><b>{{ participants }}</b> {{ libelles.formation.personnes }}</span></div>{% endif %}
          {% if note %}<div class="meta-item"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M4 3H20V15L12 21L4 15Z"/><path d="M8 10L11 13L16 8"/></svg><span><b>{{ note }}</b>{% if avis %} · {{ avis }} {{ libelles.formation.avis }}{% endif %}</span></div>{% endif %}
          {% if depuis %}<div class="meta-item"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M3 5H21V21H3Z"/><path d="M3 10H21M8 3V7M16 3V7"/></svg><span>{{ libelles.formation.depuis }} <b>{{ depuis }}</b></span></div>{% endif %}
        </div>

        {% if theorie and pratique %}
        <div class="repartition">
          <div class="barre"><i class="theorie" style="width:{{ theorie }}%"></i><i class="pratique" style="width:{{ pratique }}%"></i></div>
          <div class="legende"><span class="t">{{ libelles.formation.theorie }} {{ theorie }} %</span><span class="p">{{ libelles.formation.pratique }} {{ pratique }} %</span></div>
        </div>
        {% endif %}

        {% if image %}
        <div class="visuel-detail">
          <img src="{{ image }}" alt="Formation {{ titre }}, 4SH">
        </div>
        {% endif %}

        <!-- NAV ANCRES -->
        <nav class="ancres" aria-label="Sommaire de la formation">
          <div class="ancres-inner">
            <a href="#description" class="actif">{{ libelles.formation.ancre_description }}</a>
            <a href="#objectifs">{{ libelles.formation.ancre_objectifs }}</a>
            <a href="#programme">{{ libelles.formation.ancre_programme }}</a>
            {% if formateur_vue %}<a href="#formateur">{{ libelles.formation.ancre_formateur }}</a>{% endif %}
            <a href="#modalites">{{ libelles.formation.ancre_modalites }}</a>
            <a href="#liees">{{ libelles.formation.ancre_liees }}</a>
          </div>
        </nav>

        <!-- DESCRIPTION -->
        <section id="description" style="padding:44px 0 0">
          <div class="bloc-detail">
            <h2>{{ libelles.formation.description_titre }} <em class="accent">{{ titre }}</em></h2>
            {{ content | safe }}
            {% if pour_qui %}<h3>{{ libelles.formation.pour_qui_titre }}</h3><p>{{ pour_qui | accent | safe }}</p>{% endif %}
            {% if prerequis and prerequis.length %}
            <h3>{{ libelles.formation.prerequis_titre }}</h3>
            <ul class="liste-prereq">
              {% for p in prerequis %}<li>{{ p }}</li>{% endfor %}
            </ul>
            {% endif %}
          </div>
        </section>

        <!-- OBJECTIFS -->
        {% if objectifs and objectifs.length %}
        <section id="objectifs" style="padding:48px 0 0">
          <div class="bloc-detail">
            <h2>{{ libelles.formation.objectifs_titre | accent | safe }}</h2>
            <ul class="liste-check">
              {% for o in objectifs %}<li>{{ o }}</li>{% endfor %}
            </ul>
          </div>
        </section>
        {% endif %}

        <!-- PROGRAMME -->
        {% if programme and programme.length %}
        <section id="programme" style="padding:48px 0 0">
          <div class="bloc-detail">
            <h2>{{ libelles.formation.programme_titre }} <em class="accent">{{ titre }}</em></h2>
            <div class="programme">
              {% for chap in programme %}
              <details{% if loop.first %} open{% endif %}>
                <summary>{{ chap.titre }}</summary>
                <ul class="contenu">{% for item in chap.points %}<li>{{ item }}</li>{% endfor %}</ul>
              </details>
              {% endfor %}
            </div>
          </div>
        </section>
        {% endif %}

        <!-- FORMATEUR -->{# fiche Équipe reliée : formateur_vue est calculé dans formations.11tydata.js #}
        {% if formateur_vue %}
        <section id="formateur" style="padding:48px 0 0">
          <div class="bloc-detail" style="max-width:none">
            <h2 style="max-width:820px">{{ libelles.formation.formateur_titre | accent | safe }}</h2>
            <div class="formateur">
              <div class="portrait">
                {% if formateur_vue.photo %}<img src="{{ formateur_vue.photo }}" alt="{{ formateur_vue.nom }}, formateur {{ titre }} chez 4SH">{% endif %}
                <b>{{ formateur_vue.nom }}</b>
                <span>{{ formateur_vue.role }}</span>
              </div>
              <div>
                {% for para in formateur_vue.bio %}<p{% if loop.last %} style="margin-bottom:0"{% endif %}>{{ para | accent | safe }}</p>{% endfor %}
              </div>
            </div>
          </div>
        </section>
        {% endif %}

        <!-- FAQ -->
        {% if faq and faq.length %}
        <section style="padding:48px 0 0">
          <div class="bloc-detail">
            <h2>{{ libelles.formation.faq_titre }} <em class="accent">{{ titre }}</em></h2>
            <div class="faq" style="margin-top:8px">
              {% for item in faq %}
              <details{% if loop.first %} open{% endif %}>
                <summary>{{ item.question }}</summary>
                <p>{{ item.reponse }}</p>
              </details>
              {% endfor %}
            </div>
          </div>
        </section>
        {% endif %}

        <!-- MODALITÉS -->
        <section id="modalites" style="padding:48px 0 0">
          <div class="bloc-detail" style="max-width:none">
            <h2 style="max-width:820px">{{ libelles.formation.modalites_titre | accent | safe }}</h2>
            {% set modalite_icones = [
              '<path d="M4 8H16V18L14 20H6L4 18Z"/><path d="M16 10H19V14H16M7 3V5M10 3V5M13 3V5"/>',
              '<path d="M5 3V9H9V3M7 9V21M15 3H18V21M15 3V12H18"/>',
              '<path d="M3 3H21V21H3Z"/><path d="M9 17V7H14L16 9V11L14 13H9"/>'
            ] %}
            <div class="modalites">
              {% for m in libelles.modalites %}
              <div class="modalite"><div class="rond"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">{{ modalite_icones[loop.index0] | accent | safe }}</svg></div><b>{{ m.titre }}</b><p>{{ m.texte }}</p></div>
              {% endfor %}
            </div>
          </div>
        </section>

        <!-- AUTRES FORMATIONS DE LA CATÉGORIE -->
        <section id="liees" style="padding:48px 0 0">
          <div class="bloc-detail" style="max-width:none">
            <h2 style="max-width:820px">{{ libelles.formation.autres_titre }} <em class="accent">{{ categorie }}</em></h2>
            <div class="autres">
              {% for grp in collections.formationsParGroupe %}{% if grp.categorie == categorie and grp.groupe != groupe %}
              <a class="mini-form" href="{{ grp.url }}">{% if grp.image %}<img src="{{ grp.image }}" alt="{{ grp.titre }}">{% endif %}<b>{{ grp.titre }}</b><span>{{ libelles.formation.a_partir_de }} {{ grp.prixMin }} €</span></a>
              {% endif %}{% endfor %}
            </div>
            <div class="centre" style="margin-top:34px"><a class="btn btn-ghost" href="/formations/">{{ libelles.formation.voir_toutes }}</a></div>
          </div>
        </section>

      </div><!-- /.detail-main -->

    </div><!-- /.detail-grille -->
  </div>
</div>

<!-- DEVIS (mutualisé) -->
{{ devis(libelles.devis, site.formulaire, page.url, id="devis", style="margin-top:70px",
         sujet_defaut=site.formulaire.sujet_defaut_formation) }}

<!-- MODALE PRÉ-INSCRIPTION -->
<div class="modale" id="modale-inscription" onclick="if(event.target===this)fermerModale()">
  <div class="modale-corps">
    <button class="fermer" onclick="fermerModale()" aria-label="Fermer">×</button>
    <span class="eyebrow">{{ libelles.preinscription.eyebrow }}</span>
    <h3>Formation {{ titre }}{% if niveau %} - {{ niveau }}{% endif %}</h3>
    {% if duree %}<p style="font-size:14px;color:var(--muted);margin-bottom:8px">{{ duree | accent | safe }}</p>{% endif %}
    <form class="formulaire-modale" name="preinscription-formation" method="POST" action="/merci/" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="preinscription-formation">
      <input type="hidden" name="formation" value="{{ titre }}{% if niveau %} - {{ niveau }}{% endif %}">
      <input type="hidden" name="page" value="{{ page.url }}">
      {# le type de demande est connu ici : pré-inscription à une formation #}
      <input type="hidden" name="sujet" value="{{ site.formulaire.sujet_defaut_formation }}">
      <input type="hidden" name="destinataire" value="{% for s in site.formulaire.sujets %}{% if s.label == site.formulaire.sujet_defaut_formation %}{{ s.email }}{% endif %}{% endfor %}">
      <p hidden><label>Ne pas remplir <input name="bot-field"></label></p>

      <label for="m-entreprise">{{ libelles.preinscription.label_entreprise }}</label>
      <input id="m-entreprise" name="entreprise" type="text" required>
      <label for="m-email">{{ libelles.preinscription.label_email }}</label>
      <input id="m-email" name="email" type="email" required>
      <label for="m-tel">{{ libelles.preinscription.label_tel }}</label>
      <input id="m-tel" name="telephone" type="tel" required>
      <label id="m-nb-label" for="m-nb">{{ libelles.preinscription.label_nb }}</label>
      <div class="champ-select" data-dropdown>
        <select id="m-nb" name="participants">
          <option>1 participant</option><option>2 participants</option><option>3 participants</option><option>4 participants</option><option>5 participants</option><option>6 participants</option><option>7 participants</option><option>8 participants</option>
        </select>
      </div>

      {{ case_rgpd(site.formulaire, "rgpd-modale") }}

      <button class="btn btn-learning" type="submit" style="width:100%;justify-content:center;margin-top:22px">{{ libelles.preinscription.bouton }}</button>
    </form>
  </div>
</div>

<script>
function ouvrirModale(){document.getElementById('modale-inscription').classList.add('ouverte');document.body.style.overflow='hidden';}
function fermerModale(){document.getElementById('modale-inscription').classList.remove('ouverte');document.body.style.overflow='';}
document.addEventListener('keydown',function(e){if(e.key==='Escape')fermerModale();});
(function(){
  var liens = Array.prototype.slice.call(document.querySelectorAll('.ancres a'));
  var sections = liens.map(function(a){return document.querySelector(a.getAttribute('href'));}).filter(Boolean);
  if(!('IntersectionObserver' in window)) return;
  var obs = new IntersectionObserver(function(entrees){
    entrees.forEach(function(e){
      if(e.isIntersecting){
        liens.forEach(function(a){a.classList.toggle('actif', a.getAttribute('href')==='#'+e.target.id);});
      }
    });
  },{rootMargin:'-45% 0px -50% 0px'});
  sections.forEach(function(s){obs.observe(s);});
})();
</script>
