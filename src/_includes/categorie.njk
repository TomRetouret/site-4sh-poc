---
layout: base.njk
bodyClass: learning
learningStyles: true
catalogueStyles: true
permalink: "/formations/{{ page.fileSlug }}/"
---
<div class="hero-form">
  <div class="container">
    <nav class="fil-ariane" aria-label="Fil d'Ariane"><a href="/">Accueil</a> › <a href="/formations/">Formations</a> › {{ nom }}</nav>
    <div class="hero-grille">
      <div>
        <span class="eyebrow">4SH Learning</span>
        <h1>{{ h1 or ('Formations ' + nom) }}</h1>
        {% if intro %}<p class="chapo">{{ intro }}</p>{% endif %}
        <div class="hero-cta">
          <a class="btn btn-learning" href="#catalogue">Voir les formations</a>
          <a class="btn btn-ghost" href="#contact" style="border-color:var(--violet);color:var(--violet)">Devis sur mesure</a>
        </div>
      </div>
      <div class="visuel-form">
        <img src="https://www.4sh.fr/assets/img/svg/illu-learning.svg" alt="4SH Learning, formations {{ nom }}">
        <div class="chips" style="justify-content:center"><span>Présentiel &amp; distanciel</span><span>Certifié Qualiopi</span></div>
      </div>
    </div>
  </div>
</div>

<!-- CATALOGUE DE LA CATÉGORIE -->
<section id="catalogue" style="padding-top:60px">
  <div class="container">
    <h2 class="sec-titre">Formations <em class="accent">{{ nom }}</em></h2>
    {% set categorieActive = nom %}
    {% include "catalogue-grille.njk" %}
  </div>
</section>

<!-- TEXTE SEO + FAQ -->
<section style="padding-top:0">
  <div class="container">
    <div class="prose" style="max-width:820px;font-size:16.5px">
      {{ content | safe }}
    </div>
    {% if faq and faq.length %}
    <div class="faq" style="margin-top:36px">
      {% for item in faq %}
      <details{% if loop.first %} open{% endif %}>
        <summary>{{ item.question }}</summary>
        <p>{{ item.reponse }}</p>
      </details>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>

<!-- CONTACT / DEVIS -->
<section class="contact-final sur-sombre" id="contact">
  <div class="container">
    <div class="contact-grille">
      <div>
        <h2 class="sec-titre">Un besoin de formation <em class="accent" style="color:#a996d6">sur mesure</em> ?</h2>
        <p class="sec-sous" style="margin-bottom:18px">Décrivez-nous votre besoin : nombre de participants, niveau, sujets. Nous revenons vers vous avec une proposition adaptée et un devis.</p>
        <ul class="arguments">
          <li>Formations construites à partir de projets réels</li>
          <li>Formateurs experts, en poste sur nos projets</li>
          <li>Prise en charge OPCO possible, organisme Qualiopi</li>
          <li>Jusqu'à -50 % pour une formation en intra-entreprise</li>
        </ul>
      </div>
      <form class="formulaire" onsubmit="return false">
        <label for="nom">Nom et prénom</label>
        <input id="nom" type="text" placeholder="Prénom et nom">
        <label for="email">Email professionnel</label>
        <input id="email" type="email" placeholder="prenom@entreprise.fr">
        <label for="besoin">Votre besoin</label>
        <textarea id="besoin" rows="3" placeholder="Ex. : former 6 développeurs, niveau fondamental, en intra..."></textarea>
        <button class="btn btn-learning" type="submit" style="width:100%;justify-content:center;margin-top:24px">Demander un devis</button>
        <p class="reassurance">Réponse sous 48 h. Vos données sont traitées selon notre notice RGPD.</p>
      </form>
    </div>
  </div>
</section>
