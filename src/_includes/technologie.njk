---
layout: base.njk
---
{% from "composants/page.njk" import doodle %}
{% from "composants/sections.njk" import faq_schema, faq_accordeon %}
{% from "composants/cartes.njk" import apercu_projet, carte_atout %}
{% from "composants/formulaires.njk" import contact_final as bloc_contact %}
<!-- HERO INTERNE -->
<div class="hero-interne">
  <div class="container">
    <nav class="fil-ariane" aria-label="Fil d'Ariane"><a href="/">Accueil</a> &rsaquo; <a href="/expertises-techniques/">Expertises techniques</a> &rsaquo; {{ nom }}</nav>
    <div class="hero-grille">
      <div>
        <p class="eyebrow">Expertise technique</p>
        <h1>{{ h1 | accent | safe }}</h1>
        <p class="chapo" style="font-size:18px;color:var(--texte-2);margin-bottom:26px">{{ intro }}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/contact/">Contactez-nous</a>
          {% if formations and formations.length %}<a class="btn btn-ghost" href="#formations">Nos formations</a>{% endif %}
        </div>
      </div>
      {% if logo %}
      <div class="techno-blason" aria-hidden="true">
        <img src="{{ logo }}" alt="{{ nom }}" loading="eager" decoding="async">
      </div>
      {% endif %}
    </div>
  </div>
</div>

<!-- POURQUOI -->
<section>
  <div class="container">
    {% if pourquoi_eyebrow or not sans_surtitres %}<p class="eyebrow">{{ pourquoi_eyebrow or ("Pourquoi " + nom + " ?") }}</p>{% endif %}
    {% if pourquoi_titre %}<h2 class="sec-titre">{{ pourquoi_titre | accent | safe }}</h2>{% endif %}
    {% if pourquoi_intro %}<p class="sec-sous">{{ pourquoi_intro }}</p>{% endif %}
    <div class="atouts" style="grid-template-columns:repeat(4,1fr)">
      {% for a in atouts %}
      {{ carte_atout(a, loop.index) }}
      {% endfor %}
    </div>
  </div>
</section>

<!-- RÉFÉRENCES CLIENTS -->
{# Position : juste après « Pourquoi », ou après la section n° references_apres_section du contenu détaillé #}
{% set bloc_refs %}
{% if references and references.length %}
<section{% if not references_titre %} style="padding-top:0"{% endif %}>
  <div class="container">
    {% if references_titre %}<h2 class="sec-titre">{{ references_titre | accent | safe }}</h2>{% else %}<p class="eyebrow">Références clients</p>{% endif %}
    {% if references_intro %}<p class="sec-sous">{{ references_intro }}</p>{% endif %}
    <div class="sect-refs-inline">
      {% for r in references %}
      {% set fiche = collections.references | ficheParSlug(r.fiche) %}
      {{ apercu_projet(r.titre, r.texte, fiche, fiche.url if fiche else null) }}
      {% endfor %}
    </div>
    {% if references_bouton %}<p style="margin-top:28px"><a class="btn btn-ghost" href="/references/">{{ references_bouton }}</a></p>{% endif %}
  </div>
</section>
{% endif %}
{% endset %}
{% set refs_rang = references_apres_section if (references_apres_section and sections and sections.length > references_apres_section) else 0 %}
{% if not refs_rang %}{{ bloc_refs | safe }}{% endif %}

<!-- CORPS MARKDOWN (communauté, écosystème, guide technologie) -->
{# Sections du formulaire ; repli sur l'ancien corps de texte s'il en reste un.
   Avec references_apres_section, le contenu est coupé en deux autour des références. #}{% set corps = (sections.slice(0, refs_rang) if refs_rang else sections) | corpsSections -%}
{%- if not corps %}{% set corps = content %}{% endif -%}
{% if corps %}
{% if corps_sombre %}
{# Fond nuit (.section-nuit, charte.css) : .section-sombre est en fond clair depuis la charte v1.1
   (Méthode 4D). Contrastes sur nuit #0B0D10 : texte --sur-nuit 10,6:1, titre et surtitre blancs 19,5:1,
   liens blancs soulignés (.sur-sombre). -#}
<section class="section-nuit sur-sombre">
  <div class="container">
    {% if corps_eyebrow or not sans_surtitres %}<p class="eyebrow">{{ corps_eyebrow or "Communauté et écosystème" }}</p>{% endif %}
    {% if corps_titre %}<h2 class="sec-titre">{{ corps_titre | accent | safe }}</h2>{% endif %}
    <div class="prose prose--sombre">{{ corps | safe }}</div>
  </div>
</section>
{% else %}
<section style="padding-bottom:0">
  <div class="container">
    {% if corps_eyebrow or not sans_surtitres %}<p class="eyebrow">{{ corps_eyebrow or "Communauté et écosystème" }}</p>{% endif %}
    {% if corps_titre %}<h2 class="sec-titre">{{ corps_titre | accent | safe }}</h2>{% endif %}
  </div>
</section>
{{ corps | blocs | safe }}
{% endif %}
{% endif %}
{% if refs_rang %}
{{ bloc_refs | safe }}
{{ sections.slice(refs_rang) | corpsSections | blocs | safe }}
{% endif %}

<!-- NOS FORMATIONS -->
{% if formations and formations.length %}
<section id="formations">
  <div class="container">
    {% if formations_titre %}<h2 class="sec-titre">{{ formations_titre | accent | safe }}</h2>{% else %}<p class="eyebrow">Nos formations</p>{% endif %}
    {% if formations_intro %}<p class="sec-sous">{{ formations_intro }}</p>{% endif %}
    <div class="socle" style="grid-template-columns:repeat(3,1fr)">
      {% for f in formations %}{% set fiche_formation = collections.formations | ficheParSlug(f.formation) %}
      <a class="socle-carte" href="{{ fiche_formation.url if fiche_formation else '#' }}">{% if fiche_formation and fiche_formation.data.image %}{% image fiche_formation.data.image, "", { loading: "lazy" } %}{% endif %}<h3>{{ f.titre }}</h3><span class="socle-lien">Découvrir →</span></a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if faq and faq.length %}
{{ faq_schema(faq) }}
<section style="background:var(--creme)">
  <div class="container">
    <div class="sect-faq" style="max-width:820px;margin:0 auto">
      <h2 class="sec-titre">{{ (faq_titre or ("Questions fréquentes sur " + nom)) | accent | safe }}</h2>
      {{ faq_accordeon(faq, "margin-top:20px") }}
    </div>
  </div>
</section>
{% endif %}

{% if cta_titre or cta_texte %}
<!-- APPEL À L'ACTION FINAL -->
<section style="text-align:center">
  <div class="container">
    {% if cta_titre %}<h2 class="sec-titre" style="margin-left:auto;margin-right:auto">{{ cta_titre | accent | safe }}</h2>{% endif %}
    {% if cta_texte %}<p class="sec-sous" style="margin-left:auto;margin-right:auto">{{ cta_texte }}</p>{% endif %}
    <p style="margin-top:20px"><a class="btn btn-primary" href="/contact/">Contactez-nous</a></p>
  </div>
</section>
{% endif %}

{{ bloc_contact(site, page.url) }}
