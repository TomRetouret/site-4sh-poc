{#
  CORPS DE LA PAGE EXPERTISES TECHNIQUES
  Partage par /expertises-techniques/ et /en/tech-expertise/.

  p            : le bundle page_technologies (groupes seo, hero, phares, autres :
                 docs/back-office/schema-pages.md)
  site         : le bundle site correspondant
  technologies : collections.technologies
  url_page     : page.url
#}
{% from "composants/formulaires.njk" import contact_final as bloc_contact %}

{% macro corps(p, site, technologies, url_page) %}

<!-- HERO INTERNE -->
<div class="hero-interne">
  <div class="container">
    <nav class="fil-ariane" aria-label="{{ (("commun.fil_ariane_aria" | libelle(url_page)) or "Fil d\'Ariane") | texteHtml | safe }}"><a href="{{ ("commun.accueil_url" | libelle(url_page)) or "/" }}">{{ ("commun.fil_ariane_accueil" | libelle(url_page)) or "Accueil" }}</a> &rsaquo; {{ ("commun.fil_ariane_technologies" | libelle(url_page)) or "Expertises techniques" }}</nav>
    <div class="hero-grille">
      <div>
        <p class="eyebrow">{{ p.hero.surtitre }}</p>
        <h1>{{ p.hero.titre | accent | safe }}</h1>
        <p class="chapo" style="font-size:18px;color:var(--texte-2);margin-bottom:26px">{{ p.hero.intro }}</p>
        <div class="hero-cta">
          {% if p.hero.bouton and p.hero.bouton.texte %}<a class="btn btn-primary" href="{{ p.hero.bouton.lien or '/contact/' }}">{{ p.hero.bouton.texte }}</a>{% endif %}
        </div>
      </div>
      <div class="techno-blason" aria-hidden="true">
        <svg viewBox="0 0 200 200" fill="none" stroke="#ED203D" stroke-width="4" stroke-linecap="square" stroke-linejoin="miter">
          <path d="M60 70 40 100l20 30M140 70l20 30-20 30M112 55 88 145"/>
        </svg>
      </div>
    </div>
  </div>
</div>

<!-- TECHNOS PHARES -->
<section>
  <div class="container">
    <h2 class="sec-titre">{{ p.phares.titre | accent | safe }}</h2>
    <div class="phares">
      {% for t in technologies %}
      <article class="phare-carte {{ 'famille-' + t.data.famille if t.data.famille }}">
        {% if t.data.logo %}<span class="phare-logo"><img src="{{ t.data.logo }}" alt="{{ t.data.nom }}" loading="lazy" decoding="async"></span>{% endif %}
        <h3>{{ t.data.nom }}</h3>
        <p>{{ t.data.accroche_courte }}</p>
        <a href="{{ t.url }}">{{ ("blocs.technologies_lien" | libelle(url_page)) or "En savoir plus →" }}</a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<!-- AUTRES TECHNOS -->
<section style="padding-top:0">
  <div class="container">
    <p class="sec-sous" style="max-width:none">{{ p.autres.intro }}</p>
    <div class="autres-technos">
      {% for a in p.autres.technos %}
      <div class="techno-tuile">{% if a.logo %}<img src="{{ a.logo }}" alt="{{ a.nom }}" loading="lazy" decoding="async">{% endif %}<span>{{ a.nom }}</span></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- CONTACT -->
{{ bloc_contact(site, url_page) }}
{% endmacro %}
