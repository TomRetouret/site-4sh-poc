---
layout: base.njk
permalink: /podcasts/
extraCss: /assets/secteurs.css
---
{%- set p = page_podcasts -%}
<section class="sect-hero">
  <div class="container">
    <nav class="fil-ariane" aria-label="Fil d'Ariane"><a href="/">Accueil</a> &rsaquo; Podcasts</nav>
    <span class="eyebrow">{{ p.eyebrow }}</span>
    <h1>{{ p.h1 | accent | safe }}</h1>
    <p class="accroche">{{ p.chapo }}</p>
    <div class="hero-cta">
      {% for pl in p.plateformes %}<a class="btn {% if loop.first %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ pl.url }}" target="_blank" rel="noopener">Écouter sur {{ pl.label }}</a>{% endfor %}
    </div>
  </div>
</section>

<section class="sect-bloc">
  <div class="container">
    <div class="sect-defis">
      {% for e in p.episodes %}
      <article class="sect-defi">
        <p class="eyebrow">{{ e.date }} &middot; {{ e.duree }}</p>
        <h2>{{ e.titre }}</h2>
        <p>{{ e.resume }}</p>
        <p>
          <a href="{{ e.spotify }}" target="_blank" rel="noopener">Spotify</a>
          {% if e.deezer %} &middot; <a href="{{ e.deezer }}" target="_blank" rel="noopener">Deezer</a>{% endif %}
          {% if e.apple %} &middot; <a href="{{ e.apple }}" target="_blank" rel="noopener">Apple Podcasts</a>{% endif %}
        </p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
