{# Bloc « encart_bouton » : court message et un bouton (recrutement, charte RSE...).
   presentation « encadre » : encadré centré sur fond crème, bouton plein ; « libre » : texte aligné à gauche, bouton contour.
   Spécification : docs/back-office/schema-pages.md. #}
{% macro bloc(b, ctx) %}
{%- set l = (b.bouton.lien if b.bouton) or "#contact" %}
<!-- ENCART AVEC BOUTON -->
<section{% if b.sans_marge_haute %} style="padding-top:0"{% endif %}>
  <div class="container">
    {% if b.presentation == "libre" %}
    <div class="sect-libre" style="max-width:820px">
      <h2 class="sec-titre">{{ b.titre | escape | accent | safe }}</h2>
      {% if b.texte %}<p class="sec-sous">{{ b.texte }}</p>{% endif %}
      {% if b.bouton and b.bouton.texte %}<p><a class="btn btn-ghost" href="{{ l }}"{% if "://" in l %} target="_blank" rel="noopener"{% endif %}>{{ b.bouton.texte }}</a></p>{% endif %}
    </div>
    {% else %}
    <div class="col-carte" style="text-align:center;padding:48px 30px;background:var(--creme)">
      <h2 class="sec-titre" style="margin-bottom:10px">{{ b.titre | escape | accent | safe }}</h2>
      {% if b.texte %}<p class="sec-sous" style="margin:0 auto 24px">{{ b.texte }}</p>{% endif %}
      {% if b.bouton and b.bouton.texte %}<a class="btn btn-primary" href="{{ l }}"{% if "://" in l %} target="_blank" rel="noopener"{% endif %}>{{ b.bouton.texte }}</a>{% endif %}
    </div>
    {% endif %}
  </div>
</section>
{% endmacro %}
