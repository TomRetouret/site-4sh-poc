---
layout: base.njk
bodyClass: learning
learningStyles: true
catalogueStyles: true
permalink: "/formations/{{ page.fileSlug }}/"
---
{% from "composants/catalogue.njk" import grille as catalogue %}
{% from "composants/formulaires.njk" import devis %}
{% from "composants/pages/formations.njk" import agenda_auto %}
<div class="hero-form">
  <div class="container">
    <nav class="fil-ariane" aria-label="Fil d'Ariane"><a href="/">Accueil</a> › <a href="/formations/">Formations</a> › {{ nom }}</nav>
    <div class="hero-grille">
      <div>
        <span class="eyebrow eyebrow-offre"><span class="barre" aria-hidden="true"></span>4SH Learning</span>
        <h1>{{ (h1 or ('Formations ' + nom)) | accent | safe }}</h1>
        {% if intro %}<p class="chapo">{{ intro }}</p>{% endif %}
        {% if note %}<div class="meta-form"><span class="note-etoiles">{{ note }}{% if note_detail %} <small>· {{ note_detail }}</small>{% endif %}</span></div>{% endif %}
        {% if site.documents.catalogue_url %}<p style="font-size:14.5px;margin:0 0 24px"><a href="{{ site.documents.catalogue_url }}" target="_blank" rel="noopener">{{ site.documents.catalogue_label }}</a></p>{% endif %}
        <div class="hero-cta">
          <a class="btn btn-learning" href="#catalogue">{{ libelles.catalogue.cta_voir }}</a>
          <a class="btn btn-ghost" href="#contact">{{ libelles.catalogue.cta_devis }}</a>
        </div>
        <div class="chips">{% for chip in libelles.catalogue.chips %}<span>{{ chip }}</span>{% endfor %}</div>
      </div>
      {# Même scène que l'accueil Learning, en état final statique : seul l'accueil /formations/ est animé #}
      {% learningScene page_formations.hero_etapes %}
    </div>
  </div>
</div>

<!-- CATALOGUE DE LA CATÉGORIE -->
<section id="catalogue" style="padding-top:60px">
  <div class="container">
    <h2 class="sec-titre">Formations <em class="accent">{{ nom }}</em></h2>
    {{ catalogue(collections.formationsParGroupe, libelles, nom, "Formations " + nom) }}
  </div>
</section>

{% if agenda_titre %}
<!-- PROCHAINES SESSIONS DE LA CATÉGORIE (calculées depuis les fiches) -->
<section id="agenda" style="padding-top:0">
  <div class="container">
    <h2 class="sec-titre">{{ agenda_titre | accent | safe }}</h2>
    <div class="agenda">{{ agenda_auto(collections.formations, libelles, nom) }}</div>
  </div>
</section>
{% endif %}

{% if qualiopi and qualiopi.titre %}
<!-- QUALIOPI -->
<section style="padding-top:0">
  <div class="container">
    <div class="qualiopi">
      <div class="logo-q"><img src="/uploads/ancien-site/assets/img/png/logo-qualiopi.png" alt="Logo Qualiopi"></div>
      <div>
        <h2>{{ qualiopi.titre | accent | safe }}</h2>
        <p>{{ qualiopi.texte }}</p>
      </div>
    </div>
  </div>
</section>
{% endif %}

<!-- TEXTE SEO + FAQ -->
<section style="padding-top:0">
  <div class="container">
    <div class="prose" style="max-width:820px;font-size:16.5px">
      {{ content | safe }}
    </div>
    {% if faq and faq.length %}
    <div class="faq" style="margin-top:36px">
      {% for item in faq %}
      <details{% if loop.first %} open{% endif %}>
        <summary>{{ item.question }}</summary>
        <p>{{ item.reponse }}</p>
      </details>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>

{% if temoignages_titre %}
<!-- TÉMOIGNAGES (titre seul : les avis de l'ancien site étaient chargés dynamiquement) -->
<section style="padding-top:0">
  <div class="container">
    <h2 class="sec-titre">{{ temoignages_titre | accent | safe }}</h2>
  </div>
</section>
{% endif %}

<!-- CONTACT / DEVIS (mutualisé) -->
{{ devis(libelles.devis, site.formulaire, page.url, sujet_defaut=site.formulaire.sujet_defaut_formation) }}
