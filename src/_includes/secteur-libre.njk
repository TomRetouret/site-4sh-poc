---
layout: base.njk
permalink: "/secteurs/{{ page.fileSlug }}/"
extraCss: /assets/secteurs.css
---
{% from "composants/page.njk" import hero, bandeau_chiffres %}
{% from "composants/sections.njk" import faq_section, bloc_references %}
{% from "composants/formulaires.njk" import contact_final as bloc_contact %}
{{ hero(titre,
        h1=h1,
        eyebrow=categorie or "Secteur",
        chapo=(chapo | escape | gras | safe),
        logo=logo,
        parents=[{ "label": "Secteurs", "url": "/" }],
        ctas=[{ "label": cta_label or libelles.secteur.cta_bouton, "url": cta_url or "/#contact" }]) }}

{# Sections du formulaire ; repli sur l'ancien corps de texte s'il en reste un #}{% set corps = sections | corpsSections -%}
{%- if not corps %}{% set corps = content %}{% endif -%}
{{ corps | blocs(collections.references, page.url) | safe }}

{{ bandeau_chiffres(chiffres) }}

{% set refs_haut = page.url | refsMisesEnAvant %}
{{ bloc_references(references | sansRefs(refs_haut), collections.references,
                   libelles.secteur.refs_eyebrow, libelles.secteur.refs_titre) }}

{{ faq_section(faq, libelles.secteur.faq_titre, creme=true) }}

{{ bloc_contact(site, page.url) }}
