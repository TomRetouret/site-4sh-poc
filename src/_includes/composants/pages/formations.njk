{#
  CORPS DU CATALOGUE DE FORMATIONS
  Partage par /formations/ et /en/training/.

  p        : le bundle page_formations (groupes seo, hero, pourquoi, catalogue,
             agenda, qualiopi, temoignages : docs/back-office/schema-pages.md)
  site     : le bundle site correspondant
  libelles : le bundle libelles correspondant
  groupes  : collections.formationsParGroupe
  docs     : site.documents pour afficher les liens catalogue, Qualiopi,
             accessibilite et CGV. La page anglaise passe false : elle
             n'affiche pas ces documents aujourd'hui. Lui passer
             en.site.documents suffit a les activer.
  url_page : page.url
#}
{% from "composants/catalogue.njk" import grille as catalogue %}
{% from "composants/formulaires.njk" import devis %}


{# ---------------------------------------------------------------------------
   agenda_auto(formations, libelles, categorie=null)
   Lignes de l'agenda calculées depuis les fiches formation (collections.formations) :
   toutes les sessions à venir, triées par date, groupées par mois. categorie : filtre
   facultatif (pages de catégorie). À placer dans un conteneur <div class="agenda">.
--------------------------------------------------------------------------- #}
{% macro agenda_auto(formations, libelles, categorie=null) %}
      {# Agenda calculé : toutes les sessions à venir des fiches formation (les sessions passées
         sont déjà retirées par formations.11tydata.js), triées par date de début. #}
      {% set liste = [] %}
      {% for f in formations %}{% if not categorie or f.data.categorie == categorie %}{% for s in f.data.sessions %}{% set _ajout = liste.push({ cle: s.slice(9, 13) ~ s.slice(6, 8) ~ s.slice(3, 5), texte: s, f: f }) %}{% endfor %}{% endif %}{% endfor %}
      {% set triee = liste | sort(false, true, "cle") %}
      {% set mois_longs = ["Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"] %}
      {% set mois_courts = ["Janv.", "Févr.", "Mars", "Avr.", "Mai", "Juin", "Juil.", "Août", "Sept.", "Oct.", "Nov.", "Déc."] %}
      {% for it in triee %}
      {% if loop.first or triee[loop.index0 - 1].cle.slice(0, 6) != it.cle.slice(0, 6) %}<p class="agenda-mois">{{ mois_longs[(it.cle.slice(4, 6) | int) - 1] }} {{ it.cle.slice(0, 4) }}</p>{% endif %}
      <div class="session-ligne">
        <div class="date-bloc"><div class="jour">{{ it.cle.slice(6, 8) }}</div><div class="mois">{{ mois_courts[(it.cle.slice(4, 6) | int) - 1] }}</div><div class="duree">{{ it.f.data.duree | striptags | replace(r/\s*\(.*\)$/, "") }}</div></div>
        <div class="session-info">
          <span class="logo-mini">{% if it.f.data.image %}<img src="{{ it.f.data.image }}" alt="{{ it.f.data.titre }}">{% endif %}</span>
          <div>
            <b>{{ it.f.data.titre }}{% if it.f.data.niveau %} - {{ it.f.data.niveau }}{% endif %} <span class="pastille-cat">{{ it.f.data.categorie }}</span></b>
            <div class="details"><span>{{ it.texte }}</span></div>
          </div>
        </div>
        <a class="btn btn-learning btn-sm cta-session" href="{{ it.f.url }}">{{ (libelles.catalogue.agenda_bouton or "S\'inscrire") | texteHtml | safe }}</a>
      </div>
      {% endfor %}
{% endmacro %}

{% macro corps(p, site, libelles, groupes, docs, url_page, formations=null) %}
<div class="hero-form">
  <div class="container">
    <nav class="fil-ariane" aria-label="{{ (libelles.commun.fil_ariane_aria or "Fil d\'Ariane") | texteHtml | safe }}"><a href="{{ libelles.commun.accueil_url or "/" }}">{{ libelles.commun.fil_ariane_accueil or "Accueil" }}</a> › {{ libelles.catalogue.fil_ariane or "Formations en informatique" }}</nav>
    <div class="hero-grille">
      <div>
        <span class="eyebrow eyebrow-offre"><span class="barre" aria-hidden="true"></span>{{ p.hero.surtitre }}</span>
        <h1>{{ p.hero.titre | accent | safe }}</h1>
        <p class="chapo">{{ p.hero.chapo }}</p>
        <div class="meta-form">
          <span class="note-etoiles">{{ p.hero.note }} <small>· {{ p.hero.note_detail }}</small></span>
        </div>
        {% if p.hero.chapo_suite %}<p class="chapo">{{ p.hero.chapo_suite }}</p>{% endif %}
        <div class="hero-cta">
          <a class="btn btn-primary" href="{{ p.hero.bouton_principal.lien or '#catalogue' }}">{{ p.hero.bouton_principal.texte }}</a>
          <a class="btn btn-ghost" href="{{ p.hero.bouton_secondaire.lien or '#contact' }}">{{ p.hero.bouton_secondaire.texte }}</a>
        </div>
        <div class="chips">{% for chip in p.hero.etiquettes %}<span>{{ chip }}</span>{% endfor %}</div>
      </div>
      {# Animation « Le savoir se structure » : l'état final est écrit ici, le script le rejoue une fois #}
      <script>if(!(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)){document.documentElement.classList.add('ls-attente');setTimeout(function(){document.documentElement.classList.remove('ls-attente')},2500)}</script>
      {% learningScene p.hero.etapes %}
    </div>
  </div>
</div>
<script src="/assets/learning-scene.js" defer></script>

<!-- POURQUOI CHOISIR 4SH LEARNING -->
<section style="padding:80px 0 0">
  <div class="container">
    <h2 class="sec-titre">{{ p.pourquoi.titre | accent | safe }}</h2>
    {% set pourquoi_pictos = [
      '<path d="M3 3H9V9H3ZM15 3H21V9H15ZM3 15H9V21H3ZM15 15H21V21H15Z"/><path d="M9 6H15M6 9V15M18 9V15M9 18H15"/>',
      '<path d="M6 3H12V9H6Z"/><path d="M3 21V14H15V21"/><path d="M16 5H20V9H16Z"/><path d="M18 13H21V21"/>',
      '<path d="M12 20h9M3 20h2M12 4v16M4 4h16v10H4z"/>'
    ] %}
    <div class="portes" style="margin-top:44px">
      {% for c in p.pourquoi.cartes %}
      <div class="porte">
        <div class="pictos"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">{{ pourquoi_pictos[loop.index0] | accent | safe }}</svg></div>
        <h3>{{ c.titre }}</h3>
        <p>{{ c.texte }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- CATALOGUE + RECHERCHE + FILTRES -->
<section id="catalogue" style="padding-top:80px">
  <div class="container">
    <h2 class="sec-titre">{{ p.catalogue.titre | accent | safe }}</h2>
    {% if p.catalogue.sous_titre %}<p class="sec-sous">{{ p.catalogue.sous_titre }}</p>{% endif %}
    {% if docs.catalogue_url %}<p class="sec-sous" style="margin-top:-6px"><a href="{{ docs.catalogue_url }}" target="_blank" rel="noopener">{{ docs.catalogue_label }}</a></p>{% endif %}
    {{ catalogue(groupes, libelles, null, p.catalogue.titre | replace("*", "")) }}
  </div>
</section>

<!-- AGENDA / PROCHAINES SESSIONS -->
<section id="agenda" style="padding-top:0">
  <div class="container">
    <h2 class="sec-titre">{{ p.agenda.titre | accent | safe }}</h2>
    {% if p.agenda.sous_titre %}<p class="sec-sous">{{ p.agenda.sous_titre }}</p>{% endif %}

    <div class="agenda">
      {% if formations %}
      {{ agenda_auto(formations, libelles) }}
      {% else %}
      {% for groupe in p.agenda.mois %}
      <p class="agenda-mois">{{ groupe.mois }}</p>
      {% for s in groupe.sessions %}
      <div class="session-ligne">
        <div class="date-bloc"><div class="jour">{{ s.jour }}</div><div class="mois">{{ s.mois_court }}</div><div class="duree">{{ s.duree }}</div></div>
        <div class="session-info">
          <span class="logo-mini">{% if s.logo %}<img src="{{ s.logo }}" alt="{{ s.titre }}">{% endif %}</span>
          <div>
            <b>{{ s.titre }} <span class="pastille-cat">{{ s.categorie }}</span></b>
            <div class="details"><span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M6 3H18V14L12 21L6 14Z"/><path d="M10 7H14V11H10Z"/></svg> {{ s.lieu }}</span><span>{{ s.modalite }}</span></div>
          </div>
        </div>
        <a class="btn btn-learning btn-sm cta-session" href="{{ s.url or '#' }}">{{ (libelles.catalogue.agenda_bouton or "S\'inscrire") | texteHtml | safe }}</a>
      </div>
      {% endfor %}
      {% endfor %}
      {% endif %}
    </div>
    {% if p.agenda.bouton.texte %}<div class="centre" style="margin-top:34px"><a class="btn btn-ghost" href="{{ p.agenda.bouton.lien or '#contact' }}" style="border-color:var(--violet);color:var(--violet)">{{ p.agenda.bouton.texte }}</a></div>{% endif %}
  </div>
</section>

<!-- QUALIOPI -->
<section style="padding-top:0">
  <div class="container">
    <div class="qualiopi">
      <div class="logo-q"><img src="/uploads/ancien-site/assets/img/png/logo-qualiopi.png" alt="Logo Qualiopi"></div>
      <div>
        <h2>{{ p.qualiopi.titre | accent | safe }}</h2>
        <p>{{ p.qualiopi.texte }}</p>
        {% if docs %}
        <p style="margin-top:10px">
          {% if docs.qualiopi_url %}<a href="{{ docs.qualiopi_url }}" target="_blank" rel="noopener">{{ docs.qualiopi_label }}</a>{% endif %}
          {% if docs.accessibilite_url %} &middot; <a href="{{ docs.accessibilite_url }}" target="_blank" rel="noopener">{{ docs.accessibilite_label }}</a>{% endif %}
          {% if docs.cgv_url %} &middot; <a href="{{ docs.cgv_url }}" target="_blank" rel="noopener">{{ docs.cgv_label }}</a>{% endif %}
        </p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<!-- TEXTE (questions fréquentes de l'ancien site, Markdown) -->
{% if p.texte %}
<section style="padding-top:0">
  <div class="container">
    <div class="prose" style="max-width:820px;font-size:16.5px">{{ p.texte | texteRiche | safe }}</div>
  </div>
</section>
{% endif %}

<!-- TÉMOIGNAGES -->
<section style="padding-top:0">
  <div class="container">
    <h2 class="sec-titre">{{ p.temoignages.titre | accent | safe }}</h2>
    {% if p.temoignages.liste and p.temoignages.liste.length %}<div class="temoins">
      {% for t in p.temoignages.liste %}
      <div class="temoin">
        <blockquote>{{ t.citation }}</blockquote>
        <div class="qui"><span class="pastille">{{ t.initiales }}</span><div><b>{{ t.nom }}</b><span>{{ t.detail }}</span></div></div>
      </div>
      {% endfor %}
    </div>{% endif %}
  </div>
</section>

<!-- CONTACT / DEVIS (mutualisé) -->
{{ devis(libelles.devis, site.formulaire, url_page, sujet_defaut=site.formulaire.sujet_defaut_formation) }}
{% endmacro %}
