---
layout: base.njk
permalink: "/secteurs/{{ page.fileSlug }}/"
extraCss: /assets/secteurs.css
---
{% from "ref-macros.njk" import carte %}
<section class="sect-hero">
  <div class="container">
    <nav class="fil-ariane" aria-label="Fil d'Ariane"><a href="/">Accueil</a> › <a href="/">Secteurs</a> › {{ titre }}</nav>
    <span class="eyebrow">Secteur · {{ titre }}</span>
    <h1>{{ (h1 or titre) | accent | safe }}<svg class="doodle" width="54" height="12" viewBox="0 0 96 12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M2 8c8-6 16-6 24 0s16 6 24 0 16-6 24 0 14 5 20 1"/></svg></h1>
    {% if accroche %}<p class="accroche">{{ accroche }}</p>{% endif %}
    <div class="hero-cta"><a class="btn btn-primary" href="/#contact">{{ libelles.secteur.cta_bouton }}</a></div>
  </div>
</section>

{% if defis and defis.length %}
<section class="sect-bloc">
  <div class="container">
    <p class="eyebrow">{{ libelles.secteur.defis_eyebrow }}</p>
    <h2>{{ libelles.secteur.defis_titre }}</h2>
    {% if defis_intro %}<p class="intro">{{ defis_intro }}</p>{% endif %}
    <div class="sect-defis">
      {% for d in defis %}
      <div class="sect-defi">
        <span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/></svg></span>
        <p>{{ d | accent | safe }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if opportunites and opportunites.length %}
<section class="sect-bloc sect-bloc--creme">
  <div class="container">
    <p class="eyebrow">{{ libelles.secteur.opportunites_eyebrow }}</p>
    <h2>{{ libelles.secteur.opportunites_titre }}</h2>
    {% if opportunites_intro %}<p class="intro">{{ opportunites_intro }}</p>{% endif %}
    <ul class="sect-liste">
      {% for o in opportunites %}<li>{{ o | accent | safe }}</li>{% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% if pourquoi and pourquoi.length %}
<section class="sect-bloc">
  <div class="container">
    <p class="eyebrow">{{ libelles.secteur.pourquoi_eyebrow }}</p>
    <h2>{{ libelles.secteur.pourquoi_titre }}</h2>
    <div class="sect-atouts">
      {% for a in pourquoi %}
      <div class="sect-atout">
        <h3>{{ a.titre }}</h3>
        {% for p in a.paras %}<p>{{ p | accent | safe }}</p>{% endfor %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if etapes and etapes.length %}
<section class="sect-bloc sect-bloc--sombre">
  <div class="container">
    <p class="eyebrow">{{ libelles.secteur.comment_eyebrow }}</p>
    <h2>{{ libelles.secteur.comment_titre }}</h2>
    {% if comment_intro %}<p class="intro">{{ comment_intro }}</p>{% endif %}
    <div class="sect-etapes">
      {% for e in etapes %}
      <div class="sect-etape">
        <div><h3>{{ e.titre }}</h3><p>{{ e.texte }}</p></div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if references and references.length %}
<section class="sect-refs">
  <div class="container">
    <p class="eyebrow">{{ libelles.secteur.refs_eyebrow }}</p>
    <h2>{{ libelles.secteur.refs_titre }}</h2>
    <div class="ref-grille">
      {% for slug in references %}{% for r in collections.references %}{% if r.fileSlug == slug %}{{ carte(r) }}{% endif %}{% endfor %}{% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% include "contact-etendu.njk" %}
