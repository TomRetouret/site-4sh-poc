{#
  CORPS DE LA PAGE ENTREPRISE
  Partagé par /notre-entreprise/ et /en/company/. Page composée de blocs
  (src/_data/contenus/<langue>/notre_entreprise.json, profil institutionnel_bilingue).
  Spécification : docs/back-office/schema-pages.md.

  e            : les contenus de la langue ({ seo, blocs })
  site         : le bundle site correspondant
  url_page     : page.url, pour le formulaire de contact
  blog, temoignages, references, appels_action : données des blocs qui les utilisent

  Retour arrière : ancien corps dans l'historique Git (données src/_data/notre_entreprise.json
  et src/_data/en/notre_entreprise.json, conservées).
#}
{% from "composants/blocs/aiguilleur.njk" import rendre_blocs %}

{% macro corps(e, site, url_page, blog, temoignages, references, appels_action) %}
{{ rendre_blocs(e.blocs, site, blog, temoignages, url_page, {
  gabarit: "offre",
  references: references,
  appels_action: appels_action
}) }}
{% endmacro %}
