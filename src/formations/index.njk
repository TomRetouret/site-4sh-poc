---
layout: base.njk
bodyClass: learning
learningStyles: true
catalogueStyles: true
permalink: /formations/
---
<div class="hero-form">
  <div class="container">
    <nav class="fil-ariane" aria-label="Fil d'Ariane"><a href="/">Accueil</a> › Formations en informatique</nav>
    <div class="hero-grille">
      <div>
        <span class="eyebrow">{{ page_formations.eyebrow }}</span>
        <h1>{{ page_formations.h1 | safe }}</h1>
        <p class="chapo">{{ page_formations.chapo }}</p>
        <div class="meta-form">
          <span class="note-etoiles"><span class="etoiles">★★★★★</span> {{ page_formations.note }} <small>· {{ page_formations.note_detail }}</small></span>
        </div>
        <div class="hero-cta">
          <a class="btn btn-learning" href="{{ page_formations.hero_cta_principal_url or '#catalogue' }}">{{ page_formations.hero_cta_principal_label }}</a>
          <a class="btn btn-ghost" href="{{ page_formations.hero_cta_secondaire_url or '#contact' }}" style="border-color:var(--violet);color:var(--violet)">{{ page_formations.hero_cta_secondaire_label }}</a>
        </div>
      </div>
      <div class="visuel-form">
        <img src="https://www.4sh.fr/assets/img/svg/illu-learning.svg" alt="4SH Learning, formations en informatique">
        <div class="chips" style="justify-content:center">{% for chip in page_formations.hero_chips %}<span>{{ chip }}</span>{% endfor %}</div>
      </div>
    </div>
  </div>
</div>

<!-- POURQUOI CHOISIR 4SH LEARNING -->
<section style="padding:80px 0 0">
  <div class="container">
    <h2 class="sec-titre">{{ page_formations.pourquoi_titre | safe }}</h2>
    {% set pourquoi_pictos = [
      '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
      '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
      '<path d="M12 20h9M3 20h2M12 4v16M4 4h16v10H4z"/>'
    ] %}
    <div class="portes" style="margin-top:44px">
      {% for p in page_formations.pourquoi %}
      <div class="porte">
        <div class="pictos"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ pourquoi_pictos[loop.index0] | safe }}</svg></div>
        <h3>{{ p.titre }}</h3>
        <p>{{ p.texte }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- CATALOGUE + RECHERCHE + FILTRES -->
<section id="catalogue" style="padding-top:80px">
  <div class="container">
    <h2 class="sec-titre">{{ page_formations.catalogue_titre | safe }}</h2>
    <p class="sec-sous">{{ page_formations.catalogue_sous }}</p>
    {% include "catalogue-grille.njk" %}
  </div>
</section>

<!-- AGENDA / PROCHAINES SESSIONS -->
<section id="agenda" style="padding-top:0">
  <div class="container">
    <h2 class="sec-titre">{{ page_formations.agenda_titre | safe }}</h2>
    <p class="sec-sous">{{ page_formations.agenda_sous }}</p>

    <div class="agenda">
      {% for groupe in page_formations.agenda %}
      <p class="agenda-mois">{{ groupe.mois }}</p>
      {% for s in groupe.sessions %}
      <div class="session-ligne">
        <div class="date-bloc"><div class="jour">{{ s.jour }}</div><div class="mois">{{ s.mois_court }}</div><div class="duree">{{ s.duree }}</div></div>
        <div class="session-info">
          <span class="logo-mini">{% if s.logo %}<img src="{{ s.logo }}" alt="{{ s.titre }}">{% endif %}</span>
          <div>
            <b>{{ s.titre }} <span class="pastille-cat">{{ s.categorie }}</span></b>
            <div class="details"><span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> {{ s.lieu }}</span><span>{{ s.modalite }}</span></div>
          </div>
        </div>
        <a class="btn btn-learning btn-sm cta-session" href="{{ s.url or '#' }}">S'inscrire</a>
      </div>
      {% endfor %}
      {% endfor %}
    </div>
    <div class="centre" style="margin-top:34px"><a class="btn btn-ghost" href="{{ page_formations.agenda_cta_url or '#contact' }}" style="border-color:var(--violet);color:var(--violet)">{{ page_formations.agenda_cta_label }}</a></div>
  </div>
</section>

<!-- QUALIOPI -->
<section style="padding-top:0">
  <div class="container">
    <div class="qualiopi">
      <div class="logo-q"><img src="https://www.4sh.fr/assets/img/png/logo-qualiopi.png" alt="Logo Qualiopi"></div>
      <div>
        <h2>{{ page_formations.qualiopi_titre | safe }}</h2>
        <p>{{ page_formations.qualiopi_texte }}</p>
      </div>
    </div>
  </div>
</section>

<!-- TÉMOIGNAGES -->
<section style="padding-top:0">
  <div class="container">
    <h2 class="sec-titre">{{ page_formations.temoignages_titre | safe }}</h2>
    <div class="temoins">
      {% for t in page_formations.temoignages %}
      <div class="temoin">
        <blockquote>{{ t.citation }}</blockquote>
        <div class="qui"><span class="pastille">{{ t.initiales }}</span><div><b>{{ t.nom }}</b><span>{{ t.detail }}</span></div></div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- CONTACT / DEVIS (mutualisé) -->
{% include "devis.njk" %}
