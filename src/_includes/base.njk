{%- from "nav-icones.njk" import navicone -%}
{%- if lang == "en" -%}{% set navigation = en.navigation %}{% set site = en.site %}{% set seo = en.seo %}{%- endif -%}
<!DOCTYPE html>
<html lang="{{ lang or 'fr' }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title or seo.titre_defaut }}</title>
<meta name="description" content="{{ description or seo.description_defaut }}">
<link rel="canonical" href="{{ seo.url }}{{ page.url }}">
{% if altUrl %}<link rel="alternate" hreflang="{{ lang or 'fr' }}" href="{{ seo.url }}{{ page.url }}">
<link rel="alternate" hreflang="{{ 'fr' if lang == 'en' else 'en' }}" href="{{ seo.url }}{{ altUrl }}">
<link rel="alternate" hreflang="x-default" href="{{ seo.url }}{{ altUrl if lang == 'en' else page.url }}">{% endif %}
{% if noindex or not seo.indexation %}<meta name="robots" content="noindex, nofollow">{% endif %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="4SH">
<meta property="og:title" content="{{ title or seo.titre_defaut }}">
<meta property="og:description" content="{{ description or seo.description_defaut }}">
<meta property="og:url" content="{{ seo.url }}{{ page.url }}">
<meta property="og:image" content="{{ seo.og_image }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css?family=Asap:400,400i,500,600,700&display=swap" rel="stylesheet">
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Organization","name":"4SH","url":"https://www.4sh.fr/","foundingDate":"2007","address":[{"@type":"PostalAddress","addressLocality":"Le Haillan","postalCode":"33185"},{"@type":"PostalAddress","addressLocality":"Capbreton","postalCode":"40130"},{"@type":"PostalAddress","addressLocality":"Paris","postalCode":"75008"}],"telephone":"+33963286273"}
</script>
<link rel="stylesheet" href="/assets/styles.css">
{% if learningStyles %}<link rel="stylesheet" href="/assets/learning.css">{% endif %}
{% if catalogueStyles %}<link rel="stylesheet" href="/assets/catalogue.css">{% endif %}
{% if extraCss %}<link rel="stylesheet" href="{{ extraCss }}">{% endif %}
</head>
<body class="{{ bodyClass }}">

{% if not hideHeader %}
<header>
  <div class="container nav">
    <a class="logo" href="{{ '/en/' if lang == 'en' else '/' }}" aria-label="4SH"><img src="https://www.4sh.fr/assets/img/png/logo_4sh_baseline.png" alt="4SH, développez vos idées"></a>
    <ul class="menu">
      {% for item in navigation.items %}
      {% if item.type == "lien" %}
      <li><a href="{{ item.url or '#' }}">{{ item.label }}</a></li>
      {% elif item.type == "menu_simple" %}
      <li>
        <a href="#">{{ item.label }}</a>
        <div class="deroulant simple">
          {% if item.titre_col %}<p class="deroulant-titre">{{ item.titre_col }}</p>{% endif %}
          <ul>
            {% for l in item.liens %}<li><a href="{{ l.url or '#' }}">{{ l.label }}{% if l.sous_texte %} <small>{{ l.sous_texte }}</small>{% endif %}</a></li>{% endfor %}
          </ul>
        </div>
      </li>
      {% elif item.type == "megamenu" %}
      <li class="a-panneau">
        <a href="#">{{ item.label }}</a>
        <div class="deroulant menu-services{% if item.variant %} {{ item.variant }}{% endif %}" aria-label="{{ item.label }}">
          {% if item.promo %}
          <a class="promo-services" href="{{ item.promo.url or '#' }}">
            <div class="promo-txt">
              <h4>{{ item.promo.titre | accent | safe }}</h4>
              <p>{{ item.promo.texte }}</p>
            </div>
            {% if item.promo.kpi %}<div class="promo-kpi"><b>{{ item.promo.kpi.valeur | accent | safe }}</b><span>{{ item.promo.kpi.label }}</span></div>{% endif %}
            {% if item.promo.stats %}<div class="promo-stats">{% for s in item.promo.stats %}<div><b>{{ s.valeur | accent | safe }}</b><span>{{ s.label }}</span></div>{% endfor %}</div>{% endif %}
            {% if item.promo.lien_libelle %}<span class="promo-lien">{{ item.promo.lien_libelle }} →</span>{% endif %}
          </a>
          {% endif %}
          {% for col in item.colonnes %}
          <div class="col-svc{% if col.classe %} {{ col.classe }}{% endif %}">
            <p class="deroulant-titre">{{ col.titre }}</p>
            <ul class="svc-list">
              {% for l in col.liens %}<li><a class="svc-item" href="{{ l.url or '#' }}">{% if l.image or l.icone %}<span class="svc-ico">{% if l.image %}<img src="{{ l.image }}" alt="" width="24" height="24">{% else %}{{ navicone(l.icone) }}{% endif %}</span>{% endif %}<span><b>{{ l.label }}</b>{% if l.sous_texte %}<small>{{ l.sous_texte }}</small>{% endif %}</span></a></li>{% endfor %}
            </ul>
          </div>
          {% endfor %}
          {% if item.bas %}
          <div class="services-bas">
            <div><b>{{ item.bas.titre }}</b><span>{{ item.bas.texte }}</span></div>
            {% if item.bas.cta_label %}<a class="btn btn-sm btn-contact" href="{{ item.bas.cta_url or '#' }}">{{ item.bas.cta_label }}</a>{% endif %}
          </div>
          {% endif %}
        </div>
      </li>
      {% endif %}
      {% endfor %}
    </ul>
    <div class="nav-actions">
      {% if altUrl %}<a class="lang-switch" href="{{ altUrl }}" hreflang="{{ 'fr' if lang == 'en' else 'en' }}" aria-label="{{ 'Voir la version française' if lang == 'en' else 'View the English version' }}" title="{{ 'Version française' if lang == 'en' else 'English version' }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18"/></svg><span>{{ 'FR' if lang == 'en' else 'EN' }}</span></a>{% endif %}
      {% for a in navigation.actions %}<a class="{{ a.style }}" href="{{ a.url or '#' }}">{{ a.label }}</a>{% endfor %}
    </div>
    <button class="burger" aria-label="Ouvrir le menu">☰</button>
  </div>
</header>
{% endif %}

{{ content | safe }}

<footer>
  <div class="container">
    <div class="footer-grille">
      <div>
        <p class="footer-titre">{{ site.nom }}</p>
        <p>{{ site.footer_accroche }}<br>{{ site.villes }}<br><a href="tel:{{ site.telephone_lien }}">{{ site.telephone_affiche }}</a></p>
      </div>
      {% for col in site.footer_colonnes %}
      <div>
        <p class="footer-titre">{{ col.titre }}</p>
        <ul>
          {% for l in col.liens %}<li><a href="{{ l.url or '#' }}">{{ l.label }}</a></li>{% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
    <div class="footer-bas">
      <span>{{ site.footer_legal }}{% for l in site.footer_liens_legaux %} &middot; <a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}</span>
      <span>{% for r in site.footer_reseaux %}{% if not loop.first %} · {% endif %}<a href="{{ r.url or '#' }}" target="_blank" rel="noopener">{{ r.label }}</a>{% endfor %}{% if site.footer_formations_liens and site.footer_formations_liens.length %} &middot; {{ site.footer_formations_titre }} {% for l in site.footer_formations_liens %}{% if not loop.first %}, {% endif %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }}</a>{% endfor %}{% endif %}</span>
    </div>
  </div>
</footer>

<script src="/assets/script.js"></script>
<script src="/assets/formulaires.js" defer></script>
</body>
</html>
