---
layout: base.njk
permalink: /references/
extraCss: /assets/references.css
---
{#- Carte locale : celle de composants/cartes.njk (carte_ref) sans le secteur ni les
    technologies affichés, comme les cartes de l'ancienne page 4sh.fr/references.html.
    Les attributs data-* restent, pour la recherche et les filtres. -#}
{% macro carte(ref, une=false) %}
<article class="ref-carte{% if une %} ref-carte--une{% endif %}"
  data-secteurs="{{ ref.data.secteurs | join(',') | lower }}"
  data-technologies="{{ ref.data.technologies | join(',') | lower }}"
  data-nom="{{ (ref.data.titre ~ ' ' ~ ref.data.client ~ ' ' ~ ref.data.resume ~ ' ' ~ (ref.data.technologies | join(' ')) ~ ' ' ~ (ref.data.secteurs | join(' '))) | lower }}">
  <div class="ref-visuel{% if not ref.data.image %} ref-visuel--vide{% endif %}">
    {% if ref.data.image %}{% image ref.data.image, ('' if ref.data.image_decorative else (ref.data.image_alt or ref.data.titre)), { sizes: "(max-width: 767px) 100vw, (max-width: 1199px) 50vw, 600px", width: 600, height: 450 } %}{% else %}<span class="ref-vide-nom">{{ ref.data.client }}</span>{% endif %}
    <div class="ref-cartouche">{% if ref.data.logo %}<img src="{{ ref.data.logo }}" alt="{{ ref.data.client }}" loading="lazy" decoding="async">{% else %}<span class="ref-cartouche-txt">{{ ref.data.client }}</span>{% endif %}</div>
  </div>
  <div class="ref-carte-corps">
    <h3><a href="{{ ref.url }}">{{ ref.data.titre }}</a></h3>
    <p class="resume">{{ ref.data.resume }}</p>
  </div>
</article>
{% endmacro %}
<div class="ref-hero">
  <div class="container">
    <nav class="fil-ariane" aria-label="Fil d'Ariane"><a href="/">Accueil</a> › Nos réussites</nav>
    {% if page_references.hero.surtitre %}<p class="eyebrow">{{ page_references.hero.surtitre }}</p>{% endif %}
    <h1>{{ page_references.hero.titre | accent | safe }}</h1>
    <p class="chapo">{{ page_references.hero.chapo }}</p>
  </div>
</div>


<section>
  <div class="container">
    <div class="ref-filtres ref-filtres--panel">
      <div class="ref-recherche">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M4 4H16V16H4Z"/><path d="M16 16L21 21"/></svg>
        <input type="search" id="ref-recherche" placeholder="{{ libelles.references_index.recherche_placeholder }}" aria-label="Rechercher une référence">
      </div>

      <div class="ref-facette">
        <p class="ref-facette-titre">{{ libelles.references_index.facette_secteurs }}</p>
        <div class="ref-chips">{% for s in collections.referenceFiltres.secteurs %}<button class="chip" type="button" data-dim="secteurs" data-val="{{ s | lower }}" aria-pressed="false">{{ s }}</button>{% endfor %}</div>
      </div>

      <div class="ref-facette">
        <p class="ref-facette-titre">{{ libelles.references_index.facette_technologies }}</p>
        <div class="ref-chips">{% for t in collections.referenceFiltres.technologies %}<button class="chip" type="button" data-dim="technologies" data-val="{{ t | lower }}" aria-pressed="false">{{ t }}</button>{% endfor %}</div>
      </div>

      <div class="ref-barre-bas">
        <p class="ref-compteur" aria-live="polite"><b id="ref-nb">{{ collections.references.length }}</b> {{ libelles.references_index.compteur }}</p>
        <button class="ref-reset" id="ref-reset" type="button" hidden>{{ libelles.references_index.reset }}</button>
      </div>
    </div>

    <h2 class="sr-only">Liste des réalisations</h2>
    <div class="ref-grille" id="ref-grille">
      {% for ref in collections.references %}{{ carte(ref, une=loop.first) }}{% endfor %}
    </div>
    <p class="ref-vide-msg" id="ref-vide">{{ libelles.references_index.vide }} <button type="button" id="ref-vide-reset">{{ libelles.references_index.vide_reset }}</button></p>
  </div>
</section>

<script>
(function(){
  var cartes = Array.prototype.slice.call(document.querySelectorAll('#ref-grille .ref-carte'));
  var chips = Array.prototype.slice.call(document.querySelectorAll('.ref-chips .chip'));
  var champ = document.getElementById('ref-recherche');
  var nb = document.getElementById('ref-nb');
  var vide = document.getElementById('ref-vide');
  var grille = document.getElementById('ref-grille');
  var reset = document.getElementById('ref-reset');
  var videReset = document.getElementById('ref-vide-reset');
  var sel = { type:new Set(), secteurs:new Set(), technologies:new Set() };
  var reduit = matchMedia('(prefers-reduced-motion:reduce)').matches;

  function correspond(c){
    var q = (champ.value||'').trim().toLowerCase();
    if (q && (c.dataset.nom||'').indexOf(q) === -1) return false;
    for (var dim in sel){
      if (sel[dim].size === 0) continue;
      var vals = (c.dataset[dim]||'').split(',');
      var ok = false;
      sel[dim].forEach(function(v){ if (vals.indexOf(v) !== -1) ok = true; });
      if (!ok) return false;
    }
    return true;
  }

  function afficheCarte(c, montre, i){
    if (reduit){ c.style.display = montre ? '' : 'none'; return; }
    if (montre){
      if (c.style.display === 'none' || c.classList.contains('sortie')){
        c.classList.remove('sortie'); c.style.display = '';
        c.classList.add('entree');
        var delai = Math.min(i,6)*35;
        requestAnimationFrame(function(){ requestAnimationFrame(function(){
          c.style.transitionDelay = delai+'ms'; c.classList.add('jouee');
        }); });
        c.addEventListener('transitionend', function n(){ c.classList.remove('entree','jouee'); c.style.transitionDelay=''; c.removeEventListener('transitionend', n); });
      }
    } else if (c.style.display !== 'none'){
      c.classList.add('sortie');
      setTimeout(function(){ if (c.classList.contains('sortie')) c.style.display='none'; }, 200);
    }
  }

  function applique(){
    var visibles = 0, i = 0;
    cartes.forEach(function(c){
      var montre = correspond(c);
      if (montre) visibles++;
      afficheCarte(c, montre, i);
      if (montre) i++;
    });
    nb.textContent = visibles;
    vide.style.display = visibles ? 'none' : 'block';
    grille.style.display = visibles ? '' : 'none';
    var actif = champ.value.trim() !== '' || sel.type.size || sel.secteurs.size || sel.technologies.size;
    reset.hidden = !actif;
  }

  chips.forEach(function(chip){
    chip.addEventListener('click', function(){
      var dim = chip.dataset.dim, val = chip.dataset.val;
      if (sel[dim].has(val)){ sel[dim].delete(val); chip.setAttribute('aria-pressed','false'); }
      else { sel[dim].add(val); chip.setAttribute('aria-pressed','true'); }
      applique();
    });
  });
  champ.addEventListener('input', applique);

  function reinit(){
    champ.value = '';
    for (var d in sel) sel[d].clear();
    chips.forEach(function(c){ c.setAttribute('aria-pressed','false'); });
    applique();
  }
  reset.addEventListener('click', reinit);
  videReset.addEventListener('click', reinit);
  applique();
})();
</script>
