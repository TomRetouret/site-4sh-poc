---
layout: base.njk
permalink: "/secteurs/{{ page.fileSlug }}/"
extraCss: /assets/secteurs.css
---
{% from "composants/page.njk" import hero %}
{% from "composants/sections.njk" import bloc_references %}
{% from "composants/formulaires.njk" import contact_final as bloc_contact %}
{{ hero(titre,
        h1=h1,
        eyebrow="Secteur · " ~ titre,
        chapo=accroche,
        parents=[{ "label": "Secteurs", "url": "/" }],
        ctas=[{ "label": libelles.secteur.cta_bouton, "url": "/#contact" }]) }}

{% if defis and defis.length %}
<section class="sect-bloc">
  <div class="container">
    <p class="eyebrow">{{ libelles.secteur.defis_eyebrow }}</p>
    <h2>{{ libelles.secteur.defis_titre }}</h2>
    {% if defis_intro %}<p class="intro">{{ defis_intro }}</p>{% endif %}
    <div class="sect-defis">
      {% for d in defis %}
      <div class="sect-defi">
        <span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/></svg></span>
        <p>{{ d | accent | safe }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if opportunites and opportunites.length %}
<section class="sect-bloc sect-bloc--creme">
  <div class="container">
    <p class="eyebrow">{{ libelles.secteur.opportunites_eyebrow }}</p>
    <h2>{{ libelles.secteur.opportunites_titre }}</h2>
    {% if opportunites_intro %}<p class="intro">{{ opportunites_intro }}</p>{% endif %}
    <ul class="sect-liste">
      {% for o in opportunites %}<li>{{ o | accent | safe }}</li>{% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% if pourquoi and pourquoi.length %}
<section class="sect-bloc">
  <div class="container">
    <p class="eyebrow">{{ libelles.secteur.pourquoi_eyebrow }}</p>
    <h2>{{ libelles.secteur.pourquoi_titre }}</h2>
    <div class="sect-atouts">
      {% for a in pourquoi %}
      <div class="sect-atout">
        <h3>{{ a.titre }}</h3>
        {% for p in a.paras %}<p>{{ p | accent | safe }}</p>{% endfor %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if etapes and etapes.length %}
<section class="sect-bloc sect-bloc--sombre">
  <div class="container">
    <p class="eyebrow">{{ libelles.secteur.comment_eyebrow }}</p>
    <h2>{{ libelles.secteur.comment_titre }}</h2>
    {% if comment_intro %}<p class="intro">{{ comment_intro }}</p>{% endif %}
    <div class="sect-etapes">
      {% for e in etapes %}
      <div class="sect-etape">
        <div><h3>{{ e.titre }}</h3><p>{{ e.texte }}</p></div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{{ bloc_references(references, collections.references,
                   libelles.secteur.refs_eyebrow, libelles.secteur.refs_titre) }}

{{ bloc_contact(site, page.url) }}
