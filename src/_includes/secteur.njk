---
layout: base.njk
permalink: "/secteurs/{{ page.fileSlug }}/"
extraCss: /assets/secteurs.css
---
{% from "ref-macros.njk" import carte %}
<section class="sect-hero">
  <div class="container">
    <nav class="fil-ariane" aria-label="Fil d'Ariane"><a href="/">Accueil</a> › <a href="/">Secteurs</a> › {{ titre }}</nav>
    <span class="eyebrow">Secteur · {{ titre }}</span>
    <h1>{{ h1 or titre }}<svg class="doodle" width="54" height="12" viewBox="0 0 96 12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M2 8c8-6 16-6 24 0s16 6 24 0 16-6 24 0 14 5 20 1"/></svg></h1>
    {% if accroche %}<p class="accroche">{{ accroche }}</p>{% endif %}
    <div class="hero-cta"><a class="btn btn-primary" href="/#contact">Contactez-nous</a></div>
  </div>
</section>

{% if defis and defis.length %}
<section class="sect-bloc">
  <div class="container">
    <p class="eyebrow">Votre contexte</p>
    <h2>Les défis de votre métier</h2>
    {% if defis_intro %}<p class="intro">{{ defis_intro }}</p>{% endif %}
    <div class="sect-defis">
      {% for d in defis %}
      <div class="sect-defi">
        <span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/></svg></span>
        <p>{{ d | safe }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if opportunites and opportunites.length %}
<section class="sect-bloc sect-bloc--creme">
  <div class="container">
    <p class="eyebrow">Les leviers</p>
    <h2>Les opportunités apportées par les outils métier</h2>
    {% if opportunites_intro %}<p class="intro">{{ opportunites_intro }}</p>{% endif %}
    <ul class="sect-liste">
      {% for o in opportunites %}<li>{{ o | safe }}</li>{% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% if pourquoi and pourquoi.length %}
<section class="sect-bloc">
  <div class="container">
    <p class="eyebrow">Notre valeur</p>
    <h2>Pourquoi 4SH ?</h2>
    <div class="sect-atouts">
      {% for a in pourquoi %}
      <div class="sect-atout">
        <h3>{{ a.titre }}</h3>
        {% for p in a.paras %}<p>{{ p | safe }}</p>{% endfor %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if etapes and etapes.length %}
<section class="sect-bloc sect-bloc--sombre">
  <div class="container">
    <p class="eyebrow">Notre approche</p>
    <h2>Comment ?</h2>
    {% if comment_intro %}<p class="intro">{{ comment_intro }}</p>{% endif %}
    <div class="sect-etapes">
      {% for e in etapes %}
      <div class="sect-etape">
        <div><h3>{{ e.titre }}</h3><p>{{ e.texte }}</p></div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if references and references.length %}
<section class="sect-refs">
  <div class="container">
    <p class="eyebrow">Ils nous font confiance</p>
    <h2>Références clients</h2>
    <div class="ref-grille">
      {% for slug in references %}{% for r in collections.references %}{% if r.fileSlug == slug %}{{ carte(r) }}{% endif %}{% endfor %}{% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="sect-cta">
  <div class="container">
    <div class="bandeau-cta">
      <div>
        <h2>Vous avez un projet en {{ titre | lower }} ?</h2>
        <p>Parlons-en. En 30 minutes, un expert 4SH vous aide à cadrer votre besoin, sans engagement.</p>
      </div>
      <a class="btn" href="/#contact">Contactez-nous</a>
    </div>
  </div>
</section>
