{%- set d = libelles.devis -%}
<section class="contact-final sur-sombre" id="{{ devis_id or 'contact' }}"{% if devis_style %} style="{{ devis_style }}"{% endif %}>
  <div class="container">
    <div class="contact-grille">
      <div>
        <h2 class="sec-titre">{{ d.titre | accent | safe }}</h2>
        <p class="sec-sous" style="margin-bottom:18px">{{ d.sous }}</p>
        <ul class="arguments">
          {% for a in d.arguments %}<li>{{ a }}</li>{% endfor %}
        </ul>
      </div>
      <form class="formulaire" name="devis-formation" method="POST" action="/merci/" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="devis-formation">
        <input type="hidden" name="page" value="{{ page.url }}">
        <p hidden><label>Ne pas remplir <input name="bot-field"></label></p>

        {% set sujet_id = "sujet-devis" %}
        {% set sujet_defaut = site.formulaire.sujet_defaut_formation %}
        {% include "champ-sujet.njk" %}

        <label for="devis-nom">{{ d.label_nom }}</label>
        <input id="devis-nom" name="nom" type="text" placeholder="{{ d.ph_nom }}" required>
        <label for="devis-email">{{ d.label_email }}</label>
        <input id="devis-email" name="email" type="email" placeholder="{{ d.ph_email }}" required>
        <label for="devis-besoin">{{ d.label_besoin }}</label>
        <textarea id="devis-besoin" name="besoin" rows="3" placeholder="{{ d.ph_besoin }}" required></textarea>

        {% set rgpd_id = "rgpd-devis" %}
        {% include "case-rgpd.njk" %}

        <button class="btn btn-learning" type="submit" style="width:100%;justify-content:center;margin-top:24px">{{ d.bouton }}</button>
        <p class="reassurance">{{ d.reassurance }}</p>
      </form>
    </div>
  </div>
</section>
