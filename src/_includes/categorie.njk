---
layout: base.njk
bodyClass: learning
learningStyles: true
catalogueStyles: true
permalink: "/formations/{{ page.fileSlug }}/"
---
<div class="hero-form">
  <div class="container">
    <nav class="fil-ariane" aria-label="Fil d'Ariane"><a href="/">Accueil</a> › <a href="/formations/">Formations</a> › {{ nom }}</nav>
    <div class="hero-grille">
      <div>
        <span class="eyebrow">4SH Learning</span>
        <h1>{{ h1 or ('Formations ' + nom) }}</h1>
        {% if intro %}<p class="chapo">{{ intro }}</p>{% endif %}
        <div class="hero-cta">
          <a class="btn btn-learning" href="#catalogue">{{ libelles.catalogue.cta_voir }}</a>
          <a class="btn btn-ghost" href="#contact" style="border-color:var(--violet);color:var(--violet)">{{ libelles.catalogue.cta_devis }}</a>
        </div>
      </div>
      <div class="visuel-form">
        <img src="https://www.4sh.fr/assets/img/svg/illu-learning.svg" alt="4SH Learning, formations {{ nom }}">
        <div class="chips" style="justify-content:center">{% for chip in libelles.catalogue.chips %}<span>{{ chip }}</span>{% endfor %}</div>
      </div>
    </div>
  </div>
</div>

<!-- CATALOGUE DE LA CATÉGORIE -->
<section id="catalogue" style="padding-top:60px">
  <div class="container">
    <h2 class="sec-titre">Formations <em class="accent">{{ nom }}</em></h2>
    {% set categorieActive = nom %}
    {% include "catalogue-grille.njk" %}
  </div>
</section>

<!-- TEXTE SEO + FAQ -->
<section style="padding-top:0">
  <div class="container">
    <div class="prose" style="max-width:820px;font-size:16.5px">
      {{ content | safe }}
    </div>
    {% if faq and faq.length %}
    <div class="faq" style="margin-top:36px">
      {% for item in faq %}
      <details{% if loop.first %} open{% endif %}>
        <summary>{{ item.question }}</summary>
        <p>{{ item.reponse }}</p>
      </details>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>

<!-- CONTACT / DEVIS (mutualisé) -->
{% include "devis.njk" %}
