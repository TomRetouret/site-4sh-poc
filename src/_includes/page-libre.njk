---
layout: base.njk
extraCss: /assets/secteurs.css
---
{#- Page libre (aujourd'hui : Intelligence artificielle). Front matter : titre, hero { surtitre, titre, chapo,
    bouton }, references, faq, contact_final, referencement ; corps Markdown réparti en sections par le filtre blocs.
    Spécification : docs/back-office/schema-pages.md -#}
{% from "composants/page.njk" import hero as hero_page, bandeau_chiffres %}
{% from "composants/sections.njk" import faq_section, bloc_references %}
{% from "composants/formulaires.njk" import contact_final as bloc_contact %}
{%- set h = hero or {} -%}
{%- set bouton = h.bouton or {} -%}
{{ hero_page(titre,
        h1=h.titre,
        eyebrow=h.surtitre,
        chapo=h.chapo,
        ctas=[{ "label": bouton.texte, "url": bouton.lien or "/contact/" }] if bouton.texte else []) }}

{{ bandeau_chiffres(chiffres) }}

{{ content | blocs(collections.references, page.url) | safe }}

{% set refs_haut = page.url | refsMisesEnAvant %}
{{ bloc_references(references | sansRefs(refs_haut), collections.references,
                   libelles.secteur.refs_eyebrow, libelles.secteur.refs_titre) }}

{{ faq_section(faq, libelles.secteur.faq_titre, creme=true) }}

{% if contact_final %}{{ bloc_contact(site, page.url) }}{% endif %}
