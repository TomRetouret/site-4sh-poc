---
layout: base.njk
bodyClass: learning
learningStyles: true
permalink: "/formations/{{ page.fileSlug }}/"
---
<!-- HERO DÉTAIL + CARTE INSCRIPTION -->
<div class="hero-detail">
  <div class="container">
    <nav class="fil-ariane" aria-label="Fil d'Ariane"><a href="/">Accueil</a> › <a href="/formations/">Formations</a> › <a href="/formations/">{{ categorie }}</a> › Formation {{ titre }}{% if sous_titre %} {{ sous_titre }}{% endif %}</nav>
    <div class="detail-grille">

      <!-- colonne gauche : présentation -->
      <div>
        <span class="eyebrow">Formations · {{ categorie }}</span>
        <h1>Formation {{ titre }}{% if sous_titre %} <em class="accent">{{ sous_titre }}</em>{% endif %}</h1>
        <p class="chapo">{{ chapo }}</p>

        {% for grp in collections.formationsParGroupe %}{% if grp.groupe == groupe and grp.niveaux.length > 1 %}
        <div class="toggle-niveau" role="tablist" aria-label="Niveau de la formation">
          {% for n in grp.niveaux %}<a{% if n.url == page.url %} class="actif" aria-current="true"{% else %} href="{{ n.url }}"{% endif %}>{{ n.niveau }}</a>{% endfor %}
        </div>
        {% endif %}{% endfor %}

        <div class="meta-grille">
          {% if duree %}<div class="meta-item"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>{{ duree | safe }}</span></div>{% endif %}
          {% if participants %}<div class="meta-item"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg><span><b>{{ participants }}</b> personnes</span></div>{% endif %}
          {% if note %}<div class="meta-item"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15 9 22 9 16.5 13.5 18.5 21 12 16.5 5.5 21 7.5 13.5 2 9 9 9"/></svg><span><b>{{ note }}</b>{% if avis %} · {{ avis }} avis{% endif %}</span></div>{% endif %}
          {% if depuis %}<div class="meta-item"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><span>Depuis <b>{{ depuis }}</b></span></div>{% endif %}
        </div>

        {% if theorie and pratique %}
        <div class="repartition">
          <div class="barre"><i class="theorie" style="width:{{ theorie }}%"></i><i class="pratique" style="width:{{ pratique }}%"></i></div>
          <div class="legende"><span class="t">Théorie {{ theorie }} %</span><span class="p">Pratique {{ pratique }} %</span></div>
        </div>
        {% endif %}

        {% if image %}
        <div class="visuel-detail">
          <img src="{{ image }}" alt="Formation {{ titre }}, 4SH">
        </div>
        {% endif %}
      </div>

      <!-- colonne droite : carte inscription sticky -->
      <aside>
        <div class="carte-inscription">
          <div class="prix-bloc">
            <div class="sessions" style="margin-bottom:6px">Prix de la formation</div>
            <div class="montant">{{ prix }}</div>
            <div class="par">par participant</div>
            <div class="promo">Pour toute demande intra-entreprise, jusqu'à <b>-50 %</b> sur une formation.</div>
          </div>
          {% if sessions and sessions.length %}
          <div class="sessions">Prochaine(s) session(s)</div>
          {% for s in sessions %}
          <div class="session">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            {{ s }}
          </div>
          {% endfor %}
          {% endif %}
          <a class="btn btn-learning" href="#" onclick="ouvrirModale();return false;">Démarrer mon inscription</a>
          <a class="btn btn-ghost" href="#devis" style="width:100%;justify-content:center;border-color:var(--violet);color:var(--violet)">Devis sur mesure</a>
          <p class="note-lieu">Disponible en présentiel (Bordeaux, Paris, Toulouse, Lyon, Marseille, Lille) ou à distance.</p>
        </div>
      </aside>

    </div>
  </div>
</div>

<!-- NAV ANCRES -->
<nav class="ancres" aria-label="Sommaire de la formation">
  <div class="container">
    <a href="#description" class="actif">Description</a>
    <a href="#objectifs">Objectifs</a>
    <a href="#programme">Programme</a>
    {% if formateur %}<a href="#formateur">Formateur</a>{% endif %}
    <a href="#modalites">Modalités d'accueil</a>
    <a href="#liees">Formations liées</a>
  </div>
</nav>

<!-- DESCRIPTION -->
<section id="description" style="padding:70px 0 0">
  <div class="container">
    <div class="bloc-detail">
      <h2>Description de la formation <em class="accent">{{ titre }}</em></h2>
      {{ content | safe }}
      {% if pour_qui %}<h3>Pour qui ?</h3><p>{{ pour_qui | safe }}</p>{% endif %}
      {% if prerequis and prerequis.length %}
      <h3>Prérequis</h3>
      <ul class="liste-prereq">
        {% for p in prerequis %}<li>{{ p }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>
  </div>
</section>

<!-- OBJECTIFS -->
{% if objectifs and objectifs.length %}
<section id="objectifs" style="padding:56px 0 0">
  <div class="container">
    <div class="bloc-detail">
      <h2>Objectifs <em class="accent">pédagogiques</em></h2>
      <ul class="liste-check">
        {% for o in objectifs %}<li>{{ o }}</li>{% endfor %}
      </ul>
    </div>
  </div>
</section>
{% endif %}

<!-- PROGRAMME -->
{% if programme and programme.length %}
<section id="programme" style="padding:56px 0 0">
  <div class="container">
    <div class="bloc-detail">
      <h2>Programme de la formation <em class="accent">{{ titre }}</em></h2>
      <div class="programme">
        {% for chap in programme %}
        <details{% if loop.first %} open{% endif %}>
          <summary>{{ chap.titre }}</summary>
          <ul class="contenu">{% for item in chap.items %}<li>{{ item }}</li>{% endfor %}</ul>
        </details>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

<!-- FORMATEUR -->
{% if formateur %}
<section id="formateur" style="padding:56px 0 0">
  <div class="container">
    <div class="bloc-detail" style="max-width:none">
      <h2 style="max-width:820px">Votre <em class="accent">formateur</em></h2>
      <div class="formateur">
        <div class="portrait">
          {% if formateur.photo %}<img src="{{ formateur.photo }}" alt="{{ formateur.nom }}, formateur {{ titre }} chez 4SH">{% endif %}
          <b>{{ formateur.nom }}</b>
          <span>{{ formateur.role }}</span>
        </div>
        <div>
          {% for para in formateur.bio %}<p{% if loop.last %} style="margin-bottom:0"{% endif %}>{{ para | safe }}</p>{% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
{% endif %}

<!-- FAQ -->
{% if faq and faq.length %}
<section style="padding:56px 0 0">
  <div class="container">
    <div class="bloc-detail">
      <h2>Vos questions sur la formation <em class="accent">{{ titre }}</em></h2>
      <div class="faq" style="margin-top:8px">
        {% for item in faq %}
        <details{% if loop.first %} open{% endif %}>
          <summary>{{ item.question }}</summary>
          <p>{{ item.reponse }}</p>
        </details>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

<!-- MODALITÉS -->
<section id="modalites" style="padding:56px 0 0">
  <div class="container">
    <div class="bloc-detail" style="max-width:none">
      <h2 style="max-width:820px">Modalités <em class="accent">d'accueil</em></h2>
      <div class="modalites">
        <div class="modalite"><div class="rond"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4z"/><path d="M6 1v3M10 1v3M14 1v3"/></svg></div><b>Café offert</b><p>Accueil autour d'un café à chaque session.</p></div>
        <div class="modalite"><div class="rond"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 2v7c0 1.1.9 2 2 2h0a2 2 0 0 0 2-2V2M5 2v20M17 2c-2 0-3 2-3 5s1 5 3 5v10"/></svg></div><b>Déjeuner inclus</b><p>Repas du midi compris dans le tarif de la formation.</p></div>
        <div class="modalite"><div class="rond"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg></div><b>Parking</b><p>Stationnement disponible sur nos sites.</p></div>
      </div>
    </div>
  </div>
</section>

<!-- AUTRES FORMATIONS DE LA CATÉGORIE -->
<section id="liees" style="padding:56px 0 0">
  <div class="container">
    <div class="bloc-detail" style="max-width:none">
      <h2 style="max-width:820px">Les autres formations <em class="accent">{{ categorie }}</em></h2>
      <div class="autres">
        {% for grp in collections.formationsParGroupe %}{% if grp.categorie == categorie and grp.groupe != groupe %}
        <a class="mini-form" href="{{ grp.url }}">{% if grp.image %}<img src="{{ grp.image }}" alt="{{ grp.titre }}">{% endif %}<b>{{ grp.titre }}</b><span>à partir de {{ grp.prixMin }} €</span></a>
        {% endif %}{% endfor %}
      </div>
      <div class="centre" style="margin-top:34px"><a class="btn btn-ghost" href="/formations/">Voir toutes les formations</a></div>
    </div>
  </div>
</section>

<!-- DEVIS -->
<section class="contact-final sur-sombre" id="devis" style="margin-top:70px">
  <div class="container">
    <div class="contact-grille">
      <div>
        <h2 class="sec-titre">Cette formation <em class="accent" style="color:#a996d6">en intra</em> ?</h2>
        <p class="sec-sous" style="margin-bottom:18px">Formez vos équipes sur votre contexte, dans vos locaux ou à distance, avec un contenu adapté. Jusqu'à -50 % pour une formation en intra-entreprise.</p>
        <ul class="arguments">
          <li>Contenu adapté à vos projets et à votre niveau</li>
          <li>Formateur expert, en poste sur nos projets</li>
          <li>Prise en charge OPCO possible, organisme Qualiopi</li>
        </ul>
      </div>
      <form class="formulaire" onsubmit="return false">
        <label for="d-nom">Nom et prénom</label>
        <input id="d-nom" type="text" placeholder="Prénom et nom">
        <label for="d-email">Email professionnel</label>
        <input id="d-email" type="email" placeholder="prenom@entreprise.fr">
        <label for="d-msg">Votre besoin</label>
        <textarea id="d-msg" rows="3" placeholder="Ex. : 6 personnes à former sur {{ titre }}, en intra, en octobre..."></textarea>
        <button class="btn btn-learning" type="submit" style="width:100%;justify-content:center;margin-top:24px">Demander un devis</button>
        <p class="reassurance">Réponse sous 48 h. Données traitées selon notre notice RGPD.</p>
      </form>
    </div>
  </div>
</section>

<!-- MODALE PRÉ-INSCRIPTION -->
<div class="modale" id="modale-inscription" onclick="if(event.target===this)fermerModale()">
  <div class="modale-corps">
    <button class="fermer" onclick="fermerModale()" aria-label="Fermer">×</button>
    <span class="eyebrow">Pré-inscription</span>
    <h3>Formation {{ titre }}{% if niveau %} - {{ niveau }}{% endif %}</h3>
    {% if duree %}<p style="font-size:14px;color:var(--muted);margin-bottom:8px">{{ duree | safe }}</p>{% endif %}
    <form onsubmit="return false">
      <label for="m-entreprise">Nom de l'entreprise *</label>
      <input id="m-entreprise" type="text" required>
      <label for="m-email">Email *</label>
      <input id="m-email" type="email" required>
      <label for="m-tel">Téléphone *</label>
      <input id="m-tel" type="tel" required>
      <label for="m-nb">Nombre de participants</label>
      <select id="m-nb"><option>1 participant</option><option>2 participants</option><option>3 participants</option><option>4 participants</option><option>5 participants</option><option>6 participants</option><option>7 participants</option><option>8 participants</option></select>
      <button class="btn btn-learning" type="submit" style="width:100%;justify-content:center;margin-top:22px">Envoyer ma pré-inscription</button>
      <p class="reassurance" style="margin-top:12px;text-align:center;font-size:12.5px;color:var(--muted)">En soumettant ce formulaire, vous acceptez notre notice d'informations RGPD.</p>
    </form>
  </div>
</div>

<script>
function ouvrirModale(){document.getElementById('modale-inscription').classList.add('ouverte');document.body.style.overflow='hidden';}
function fermerModale(){document.getElementById('modale-inscription').classList.remove('ouverte');document.body.style.overflow='';}
document.addEventListener('keydown',function(e){if(e.key==='Escape')fermerModale();});
(function(){
  var liens = Array.prototype.slice.call(document.querySelectorAll('.ancres a'));
  var sections = liens.map(function(a){return document.querySelector(a.getAttribute('href'));}).filter(Boolean);
  if(!('IntersectionObserver' in window)) return;
  var obs = new IntersectionObserver(function(entrees){
    entrees.forEach(function(e){
      if(e.isIntersecting){
        liens.forEach(function(a){a.classList.toggle('actif', a.getAttribute('href')==='#'+e.target.id);});
      }
    });
  },{rootMargin:'-45% 0px -50% 0px'});
  sections.forEach(function(s){obs.observe(s);});
})();
</script>
