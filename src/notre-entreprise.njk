---
layout: base.njk
permalink: /notre-entreprise/
extraCss: /assets/logiciel-metier.css
---
{%- set e = notre_entreprise -%}

<!-- HERO INTERNE -->
<div class="hero-interne">
  <div class="container">
    <nav class="fil-ariane" aria-label="Fil d'Ariane"><a href="/">Accueil</a> &rsaquo; L'agence &rsaquo; Notre entreprise</nav>
    <div class="hero-grille">
      <div>
        <p class="eyebrow">{{ e.hero_eyebrow }}</p>
        <h1>{{ e.hero_h1 | accent | safe }}</h1>
        <p class="chapo" style="font-size:18px;color:var(--texte-2);margin-bottom:26px">{{ e.hero_chapo }}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="{{ e.hero_cta_principal_url or '#contact' }}">{{ e.hero_cta_principal_label }}</a>
          <a class="btn btn-ghost" href="{{ e.hero_cta_secondaire_url or '#contact' }}"{% if '://' in e.hero_cta_secondaire_url %} target="_blank" rel="noopener"{% endif %}>{{ e.hero_cta_secondaire_label }}</a>
        </div>
        <div class="chips">
          {% for chip in e.hero_chips %}<span>{{ chip }}</span>{% endfor %}
        </div>
      </div>
      <div class="schema-craft" aria-hidden="true">
        <svg viewBox="0 0 480 270" fill="none" font-family="Asap,sans-serif">
          <rect x="170" y="105" width="140" height="60" rx="12" stroke="#ea2631" stroke-width="1.8"/>
          <text x="240" y="140" text-anchor="middle" fill="#1f292e" font-size="16" font-weight="600">4SH</text>
          <rect x="24" y="30" width="120" height="52" rx="12" stroke="#494849" stroke-width="1.6"/>
          <text x="84" y="61" text-anchor="middle" fill="#1f292e" font-size="13" font-weight="600">Bordeaux</text>
          <rect x="336" y="30" width="120" height="52" rx="12" stroke="#494849" stroke-width="1.6"/>
          <text x="396" y="61" text-anchor="middle" fill="#1f292e" font-size="13" font-weight="600">Capbreton</text>
          <rect x="180" y="200" width="120" height="52" rx="12" stroke="#494849" stroke-width="1.6"/>
          <text x="240" y="231" text-anchor="middle" fill="#1f292e" font-size="13" font-weight="600">Paris</text>
          <path d="M144 60c10 14 22 30 34 46" stroke="#494849" stroke-width="1.6" stroke-linecap="round"/>
          <path d="M336 60c-10 14-22 30-34 46" stroke="#494849" stroke-width="1.6" stroke-linecap="round"/>
          <path d="M240 165v33" stroke="#494849" stroke-width="1.6" stroke-linecap="round"/>
          <text x="240" y="20" text-anchor="middle" fill="#ea2631" font-size="15" font-family="Fraunces,Georgia,serif" font-style="italic">une communauté qui grandit</text>
        </svg>
      </div>
    </div>
  </div>
</div>

<!-- QUI NOUS SOMMES -->
<section>
  <div class="container">
    <p class="eyebrow">{{ e.apropos_eyebrow }}</p>
    <h2 class="sec-titre">{{ e.apropos_titre | accent | safe }}</h2>
    <div class="prose">
      {% for p in e.apropos_paragraphes %}<p>{{ p | accent | safe }}</p>{% endfor %}
    </div>
  </div>
</section>

<!-- CHIFFRES -->
<section style="padding:0">
  <div class="chiffres">
    <div class="container" style="grid-template-columns:repeat(3,1fr)">
      {% for c in e.chiffres %}
      <div><b{% if c.compte %} data-compte="{{ c.compte }}"{% if c.suffixe %} data-suffixe="{{ c.suffixe }}"{% endif %}{% endif %}>{{ c.valeur }}</b><span>{{ c.texte }}</span></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- CULTURE TECH -->
<section>
  <div class="container">
    <p class="eyebrow">{{ e.culture_eyebrow }}</p>
    <h2 class="sec-titre">{{ e.culture_titre | accent | safe }}</h2>
    <p class="sec-sous">{{ e.culture_sous }}</p>
    <div class="socle" style="grid-template-columns:repeat(3,1fr)">
      {% for c in e.culture_cartes %}
      <div class="socle-carte"><h3>{{ c.titre }}</h3><p style="font-size:14.5px;color:var(--texte-2)">{{ c.texte }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- NOS VALEURS -->
<section class="section-sombre sur-sombre">
  <div class="container">
    <p class="eyebrow">{{ e.valeurs_eyebrow }}</p>
    <h2 class="sec-titre">{{ e.valeurs_titre | accent | safe }}</h2>
    <div class="socle">
      {% for v in e.valeurs %}
      <div class="socle-carte"><h3>{{ v.titre }}</h3><p style="font-size:14.5px;color:#b9c3c8">{{ v.texte }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- NOS MÉTIERS -->
<section>
  <div class="container">
    <p class="eyebrow">{{ e.equipe_eyebrow }}</p>
    <h2 class="sec-titre">{{ e.equipe_titre | accent | safe }}</h2>
    <p class="sec-sous">{{ e.equipe_sous }}</p>
    <div class="socle" style="grid-template-columns:repeat(4,1fr)">
      {% for m in e.equipe_metiers %}
      <div class="socle-carte"><h3>{{ m.nom }}</h3></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- RECRUTEMENT -->
<section style="padding-top:0">
  <div class="container">
    <div class="col-carte" style="text-align:center;padding:48px 30px;background:var(--creme)">
      <h2 class="sec-titre" style="margin-bottom:10px">{{ e.recrutement_titre }}</h2>
      <p class="sec-sous" style="margin:0 auto 24px">{{ e.recrutement_texte }}</p>
      <a class="btn btn-primary" href="{{ e.recrutement_cta_url }}" target="_blank" rel="noopener">{{ e.recrutement_cta_label }}</a>
    </div>
  </div>
</section>

<!-- NOS AGENCES -->
<section style="padding-top:0">
  <div class="container">
    <p class="eyebrow">{{ e.agences_eyebrow }}</p>
    <h2 class="sec-titre">{{ e.agences_titre | accent | safe }}</h2>
    <p class="sec-sous">{{ e.agences_sous }}</p>
    <div class="socle">
      {% for a in e.agences %}
      <div class="socle-carte"><h3>{{ a.ville }}</h3><p style="font-size:14.5px;color:var(--texte-2)">{{ a.adresse | replace("\n", "<br>") | accent | safe }}</p>{% if a.carte_url %}<a class="socle-lien" href="{{ a.carte_url }}" target="_blank" rel="noopener">Voir sur la carte &rarr;</a>{% endif %}</div>
      {% endfor %}
    </div>
  </div>
</section>

{% if e.rse_cta_url %}
<section style="padding-top:0">
  <div class="container">
    <div class="sect-libre" style="max-width:820px">
      <h2 class="sec-titre">{{ e.rse_titre }}</h2>
      <p class="sec-sous">{{ e.rse_texte }}</p>
      <p><a class="btn btn-ghost" href="{{ e.rse_cta_url }}" target="_blank" rel="noopener">{{ e.rse_cta_label }}</a></p>
    </div>
  </div>
</section>
{% endif %}

{% include "contact-etendu.njk" %}
