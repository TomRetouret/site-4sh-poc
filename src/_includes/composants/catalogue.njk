{#
  COMPOSANT CATALOGUE DE FORMATIONS
  La barre de recherche, les onglets de categorie et la grille de fiches.
  Partage par /formations/ et par les pages de categorie.
  Voir composants/README.md.
#}

{# ---------------------------------------------------------------------------
   grille(groupes, libelles, categorie=null)
   groupes   : collections.formationsParGroupe
   libelles  : l'objet libelles (utilise .catalogue et .formation)
   categorie : nom de la categorie active, null pour « toutes »
--------------------------------------------------------------------------- #}
{% macro grille(groupes, libelles, categorie=null, titre=null) %}
{# Bandeau du catalogue : fixe au défilement, en version compacte une fois collé sous l'en-tête #}
<div class="catalogue-repere" aria-hidden="true"></div>
<div class="catalogue-barre">
{% if titre %}<p class="catalogue-barre-titre" aria-hidden="true">{{ titre }}</p>{% endif %}
<div class="barre-filtres">
  <div class="recherche">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M4 4H16V16H4Z"/><path d="M16 16L21 21"/></svg>
    <input type="search" id="recherche" placeholder="{{ libelles.catalogue.recherche_placeholder }}" aria-label="{{ libelles.catalogue.recherche_aria or 'Rechercher une formation' }}">
  </div>
</div>
<div class="ligne-outils">
  <nav class="onglets" aria-label="{{ libelles.catalogue.onglets_aria or 'Catégories de formation' }}">
    <a class="onglet{% if not categorie %} actif{% endif %}" href="/formations/"{% if not categorie %} aria-current="page"{% endif %}>{{ libelles.catalogue.onglet_toutes }}</a>
    <a class="onglet{% if categorie == 'IA' %} actif{% endif %}" href="/formations/ia/"{% if categorie == 'IA' %} aria-current="page"{% endif %}>IA</a>
    <a class="onglet{% if categorie == 'Develop' %} actif{% endif %}" href="/formations/develop/"{% if categorie == 'Develop' %} aria-current="page"{% endif %}>Develop</a>
    <a class="onglet{% if categorie == 'Design' %} actif{% endif %}" href="/formations/design/"{% if categorie == 'Design' %} aria-current="page"{% endif %}>Design</a>
    <a class="onglet{% if categorie == 'DevOps' %} actif{% endif %}" href="/formations/devops/"{% if categorie == 'DevOps' %} aria-current="page"{% endif %}>DevOps</a>
    <a class="onglet{% if categorie == 'Outils' %} actif{% endif %}" href="/formations/outils/"{% if categorie == 'Outils' %} aria-current="page"{% endif %}>Outils</a>
  </nav>
  <p class="compteur"><b id="nb-resultats">0</b> {{ libelles.catalogue.compteur }}</p>
</div>
</div>
<script>
(function () {
  // Version compacte dès que le bandeau est collé sous l'en-tête. Calcul à chaque défilement
  // (et non par IntersectionObserver, qui ne se déclenche pas lors d'un saut d'ancre ou d'un
  // défilement rapide d'un bout à l'autre de la page).
  var r = document.querySelector('.catalogue-repere'), b = document.querySelector('.catalogue-barre'), h = document.querySelector('header');
  if (!r || !b) return;
  var attente = false;
  function maj() {
    attente = false;
    var haut = h ? h.getBoundingClientRect().height : 0;
    b.classList.toggle('colle', r.getBoundingClientRect().top < haut + 1);
  }
  function demande() { if (!attente) { attente = true; requestAnimationFrame(maj); } }
  addEventListener('scroll', demande, { passive: true });
  addEventListener('resize', demande);
  addEventListener('load', maj);
  maj();
})();
</script>

<div class="grille-form" id="grille-form">
  {% for g in groupes %}{% if not categorie or g.categorie == categorie %}
  <article class="carte-form" data-nom="{{ g.titre | lower }}">
    <div class="haut"><span class="logo-techno">{% if g.image %}<img src="{{ g.image }}" alt="{{ g.titre }}">{% endif %}</span><span class="prix"><small>{{ libelles.formation.a_partir_de }}</small><b>{{ g.prixMin }} €</b></span></div>
    <span class="cat">{{ g.categorie }}</span>
    <h3><a href="{{ g.url }}">{{ g.titre }}{% if g.avis %} <span class="avis">({{ g.avis }} {{ libelles.formation.avis }})</span>{% endif %}</a></h3>
    <p class="desc">{{ g.chapo }}</p>
    <div class="niveaux">{% for n in g.niveaux %}<span class="niveau-chip"><b>{{ n.niveau }}</b>{{ n.duree | striptags }}</span>{% endfor %}</div>
  </article>
  {% endif %}{% endfor %}
</div>
<p class="vide" id="etat-vide">{{ libelles.catalogue.vide or "Aucune formation ne correspond à votre recherche. Essayez un autre mot-clé." }}</p>

<script>
(function(){
  var cartes = Array.prototype.slice.call(document.querySelectorAll('#grille-form .carte-form'));
  var champ = document.getElementById('recherche');
  var vide = document.getElementById('etat-vide');
  var nb = document.getElementById('nb-resultats');
  var grille = document.getElementById('grille-form');
  function applique(){
    var q = (champ.value || '').trim().toLowerCase();
    var visibles = 0;
    cartes.forEach(function(c){
      var montre = (q === '') || (c.dataset.nom.indexOf(q) !== -1);
      c.style.display = montre ? '' : 'none';
      if(montre) visibles++;
    });
    nb.textContent = visibles;
    vide.style.display = visibles ? 'none' : 'block';
    grille.style.display = visibles ? '' : 'none';
  }
  champ.addEventListener('input', applique);
  applique();
})();
</script>
{%- endmacro %}
