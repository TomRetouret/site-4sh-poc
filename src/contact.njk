---
layout: base.njk
permalink: /contact/
---
{% from "composants/formulaires.njk" import formulaire %}
<section class="contact-final sur-sombre" id="contact" style="margin-top:0">
  <div class="container">
    <nav class="fil-ariane" aria-label="Fil d'Ariane" style="padding-bottom:18px"><a href="/">Accueil</a> › Contact</nav>
    <div class="contact-grille">
      <div>
        <h1 class="sec-titre">{{ contact.hero.titre | accent | safe }}</h1>
        <p class="sec-sous" style="margin-bottom:18px">{{ contact.hero.chapo }}</p>
        <ul class="arguments">
          {% for a in site.contact.arguments %}<li>{{ a }}</li>{% endfor %}
        </ul>
        <div class="contact-coord">
          <p><b>{{ site.contact.coord_tel_titre }}</b><br><a href="tel:{{ site.telephone_lien }}">{{ site.telephone_affiche }}</a></p>
          <p><b>{{ site.contact.coord_agences_titre }}</b><br>{{ site.villes }}</p>
        </div>
      </div>
      {{ formulaire(site.formulaire, page.url, "contact-page", avec_tel=true) }}
    </div>
  </div>
</section>
