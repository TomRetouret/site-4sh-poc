{# Bloc « technologies » : deux affichages (champ affichage).
   nuage (défaut, accueil) : mur typographique.
   cartes : cartes avec logo (page Logiciel métier) ; le texte alternatif du logo est le nom. Fond clair : .section-sombre
   est en fond clair dans la charte ; .technos-cartes ramène les logos (blancs à l'origine) en encre (charte.css). #}
{% macro bloc(b, ctx) %}
{% if b.affichage == "cartes" %}
<!-- SOCLE TECHNOLOGIQUE (affichage cartes) -->
<section class="section-sombre technos-cartes">
  <div class="container">
    {% if b.surtitre %}<p class="eyebrow">{{ b.surtitre }}</p>{% endif %}
    <h2 class="sec-titre">{{ b.titre | accent | safe }}</h2>
    {% if b.sous_titre %}<p class="sec-sous">{{ b.sous_titre }}</p>{% endif %}
    <div class="socle">
      {% for s in b.technos %}
      <div class="socle-carte">{% if s.logo %}<img src="{{ s.logo }}" alt="{{ s.nom }}">{% endif %}<h3>{{ s.nom }}</h3>{% if s.lien %}<a href="{{ s.lien }}">{{ ("blocs.technologies_lien" | libelle(ctx.url_page)) or "En savoir plus →" }}</a>{% endif %}</div>
      {% endfor %}
    </div>
  </div>
</section>
{% else %}
<!-- TECHNOS (mur typographique) -->
<section>
  <div class="container">
    {% if b.surtitre %}<p class="eyebrow">{{ b.surtitre }}</p>{% endif %}
    <h2 class="sec-titre">{{ b.titre | accent | safe }}</h2>
    {% if b.sous_titre %}<p class="sec-sous">{{ b.sous_titre }}</p>{% endif %}
    <div class="techno-nuage">
      {% for t in b.technos %}<a class="techno-tag" href="{{ t.lien or '#' }}">{{ t.nom }}</a>{% endfor %}
    </div>
  </div>
</section>
{% endif %}
{% endmacro %}
