{#
  CORPS DE LA PAGE D'ACCUEIL
  Partage par / et /en/ : les deux pages appellent corps() avec leur propre
  jeu de donnees. Toute section modifiee ici l'est dans les deux langues.

  accueil  : le bundle accueil (src/_data/accueil.json ou en/accueil.json)
  site     : le bundle site correspondant
  blog     : les derniers articles, ou rien
  url_page : page.url, pour le formulaire de contact
#}
{% from "composants/sections.njk" import carrousel, frise_etapes %}
{% from "composants/formulaires.njk" import contact_final as bloc_contact %}

{% macro corps(accueil, site, blog, url_page) %}
<!-- HERO (option « fondu intégré » : photo full-bleed en duotone) -->
<div class="hero sur-sombre">
  <div class="container">
    <div class="hero-grille">
      <div>
        <h1 class="surtitre">{{ accueil.hero_surtitre }}</h1>
        <p class="hero-accroche">{{ accueil.hero_accroche_debut }} <em class="accent">{{ accueil.hero_accroche_accent }}</em> {{ accueil.hero_accroche_fin | accent | safe }}</p>
        <p class="chapo">{{ accueil.hero_chapo }}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#contact">{{ accueil.hero_cta_principal }}</a>
          <a class="btn btn-ghost" href="/references/">{{ accueil.hero_cta_secondaire }}</a>
        </div>
        <p class="hero-note">{{ accueil.hero_note }}</p>
      </div>
      {% if not accueil.equipe_photo %}
      <div class="hero-visuel" aria-hidden="true">
        <div class="fenetre">
          <span>{{ accueil.hero_visuel_titre }}</span><br>
          {% for l in accueil.hero_visuel_lignes %}<i>{{ l.cle }}</i> : {{ l.valeur }}<br>{% endfor %}
        </div>
        <div class="badge-projet"><span>{{ accueil.hero_visuel_badge }}</span><b>{{ accueil.hero_visuel_badge_note }}</b></div>
      </div>
      {% endif %}
    </div>
  </div>
  <svg class="hero-plan" viewBox="0 0 1440 280" preserveAspectRatio="xMaxYMax meet" aria-hidden="true" focusable="false"><path d="M0 280V200H520L560 160H800L840 120H1080L1120 80H1440V280Z" fill="#ED203D"/><path d="M1320 65L1335 80L1320 95L1305 80Z" fill="#FFFFFF"/></svg>
  <svg class="hero-plan--m" viewBox="0 0 390 170" aria-hidden="true" focusable="false"><path d="M0 170V110H180L220 70H390V170Z" fill="#ED203D"/><path d="M320 55L335 70L320 85L305 70Z" fill="#FFFFFF"/></svg>
</div>

<!-- PHOTO D'ÉQUIPE ET LOGOS CLIENTS -->
{% if accueil.equipe_photo %}
<div class="equipe-bande">
  <figure><img src="{{ accueil.equipe_photo }}" alt="{{ accueil.equipe_titre | accent | striptags }}" width="1360" height="583" loading="lazy" decoding="async"></figure>
</div>
{% endif %}
<div class="logos">
  <div class="container"><div>
    <p>{{ site.clients_intro }}</p>
    <div class="marquee"><ul aria-label="Références clients">
      {% for c in site.clients %}<li>{% if c.url %}<a href="{{ c.url }}">{{ c.nom }}</a>{% else %}{{ c.nom }}{% endif %}</li>{% endfor %}
    </ul></div>
  </div></div>
</div>

<!-- 3 PORTES D'ENTRÉE -->
<section class="fond-doux">
  <div class="container">
    <p class="eyebrow">{{ accueil.portes_eyebrow }}</p>
    <h2 class="sec-titre">{{ accueil.portes_titre | accent | safe }}</h2>
    <p class="sec-sous">{{ accueil.portes_sous }}</p>
    {% set porte_pictos = ["<path d=\"M8 6L3 12L8 18M16 6L21 12L16 18\"/><path d=\"M13.5 4L10.5 20\"/>", "<path d=\"M4 4H18L20 6V10H4Z\"/><path d=\"M4 14H18L20 16V20H4Z\"/><path d=\"M7 7H10M7 17H10\"/>", "<path d=\"M3 5H10L12 7L14 5H21V19H14L12 21L10 19H3Z\"/><path d=\"M12 7V21\"/>"] %}
    {% set porte_offres = ["4SH Build", "4SH Run", "4SH Learning"] %}
    {% set porte_familles = ["famille-build", "famille-run", "famille-formation"] %}
    <div class="portes">
      {% for p in accueil.portes %}
      <article class="porte {{ porte_familles[loop.index0] }}">
        <div class="pictos"><svg viewBox="0 0 24 24" fill="none" stroke="#14171C" stroke-width="1.5" stroke-linejoin="miter" aria-hidden="true" focusable="false">{{ porte_pictos[loop.index0] | safe }}</svg><span class="offre">{{ porte_offres[loop.index0] }}</span></div>
        <h3>{{ p.titre }}</h3>
        <p>{{ p.texte }}</p>
        <ul>
          {% for l in p.liens %}<li><a href="{{ l.url or '#' }}">{{ l.label | replace("→ ", "") }}</a></li>{% endfor %}
        </ul>
        <a class="suite" href="{{ p.suite_url or '#' }}">{{ p.suite_label }}</a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<!-- BANDEAU CHIFFRES -->
<div class="chiffres">
  <div class="container">
    {% for c in accueil.chiffres %}
    <div>
      <b><i>{{ c.valeur }}</i></b>
      {% if loop.first %}{% endif %}
      <span>{{ c.texte }}</span>{% if c.note %}<small>{{ c.note }}</small>{% endif %}
    </div>
    {% endfor %}
  </div>
</div>

<!-- SECTEURS (carrousel) -->
<section>
  <div class="container">
    <p class="eyebrow">{{ accueil.secteurs_eyebrow }}</p>
    <h2 class="sec-titre">{{ accueil.secteurs_titre | accent | safe }}</h2>
    <p class="sec-sous">{{ accueil.secteurs_sous }}</p>
    {% call carrousel("Secteurs", "car--secteurs", false) %}
        {% for s in accueil.secteurs %}
        <div class="secteur-carte"><h3>{{ s.titre }}</h3><p>{{ s.texte }}</p><a href="{{ s.url or '#' }}">{{ s.lien_libelle }}</a></div>
        {% endfor %}
    {% endcall %}
  </div>
</section>

<!-- MÉTHODE 4D -->
<section class="section-sombre">
  <div class="container">
    <p class="eyebrow">{{ accueil.methode_eyebrow }}</p>
    <h2 class="sec-titre">{{ accueil.methode_titre | accent | safe }}</h2>
    <p class="sec-sous">{{ accueil.methode_sous }}</p>
    <svg class="trace-4d" viewBox="0 0 1280 120" aria-hidden="true" focusable="false"><path d="M0 110H280L310 80H600L630 50H920L950 20H1240" fill="none" stroke="#14171C" stroke-width="2"/><path d="M1240 9L1251 20L1240 31L1229 20Z" fill="#ED203D"/></svg>
    {{ frise_etapes(accueil.methode_etapes) }}
  </div>
</section>

<!-- RÉALISATIONS -->
<section class="fond-doux">
  <div class="container">
    <p class="eyebrow">{{ accueil.cas_eyebrow }}</p>
    <h2 class="sec-titre">{{ accueil.cas_titre | accent | safe }}</h2>
    <p class="sec-sous">{{ accueil.cas_sous }}</p>
    {% call carrousel("Réalisations", "car--real", false) %}
        {% for r in accueil.realisations %}
        <div class="cas{% if r.image %} cas--image{% endif %}">
          <figure class="cas-visuel">
            {% if r.image %}<img src="{{ r.image }}" alt="{{ r.client }}, {{ r.secteur }}" loading="lazy" decoding="async">{% endif %}
            <figcaption>
              <span class="secteur">{{ r.secteur }}</span>
              <span class="logo-client">{{ r.client }}</span>
            </figcaption>
          </figure>
          <div class="cas-corps">
            {% if r.citation %}<blockquote>{{ r.citation }}</blockquote>{% if r.auteur %}<p class="auteur">{{ r.auteur }}</p>{% endif %}{% endif %}
            {% if r.visuel_texte %}<p class="cas-desc">{{ r.visuel_texte }}</p>{% endif %}
            <div class="cas-chiffre">
              {% for ch in r.chiffres %}<div><b>{{ ch.valeur | accent | safe }}</b><span>{{ ch.label }}</span></div>{% endfor %}
            </div>
            <a class="btn btn-ghost btn-sm" href="{{ r.cta_url or '#' }}">{{ r.cta_label }}</a>
          </div>
        </div>
        {% endfor %}
    {% endcall %}
    <div class="centre" style="margin-top:28px"><a class="btn btn-primary" href="{{ accueil.realisations_cta_url or '/references/' }}">{{ accueil.realisations_cta_label }}</a></div>
  </div>
</section>

<!-- TECHNOS (nuage de mots) -->
<section style="padding-top:0">
  <div class="container">
    <p class="eyebrow">{{ accueil.technos_eyebrow }}</p>
    <h2 class="sec-titre">{{ accueil.technos_titre | accent | safe }}</h2>
    <p class="sec-sous">{{ accueil.technos_sous }}</p>
    <div class="techno-nuage">
      {% for t in accueil.technos %}<a class="techno-tag" href="{{ t.url or '#' }}">{{ t.nom }}</a>{% endfor %}
    </div>
  </div>
</section>

<!-- FAQ -->
<section style="padding-top:0">
  <div class="container">
    <h2 class="sec-titre centre" style="text-align:center">{{ accueil.faq_titre }}</h2>
    <p class="sec-sous" style="margin:0 auto 38px;text-align:center">{{ accueil.faq_sous }}</p>
    <div class="faq">
      {% for item in accueil.faq %}
      <details{% if loop.first %} open{% endif %}>
        <summary>{{ item.question }}</summary>
        <p>{{ item.reponse }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for item in accueil.faq %}{"@type":"Question","name":{{ item.question | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ item.reponse | dump | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
  </script>
</section>

<!-- DERNIERS ARTICLES DU BLOG (récupérés au build, discret) -->
{% if blog and blog.length %}
<section class="blog-accueil">
  <div class="container">
    <div class="blog-tete">
      <h2 class="sec-titre">Nos derniers <em class="accent">articles</em></h2>
      <a class="blog-tout" href="https://blog.4sh.fr/">Tout le blog</a>
    </div>
    <div class="blog-grille">
      {% for a in blog %}
      <article class="blog-carte">
        <a class="blog-carte-lien" href="{{ a.url }}">
          {% if a.image %}<span class="blog-img"><img src="{{ a.image }}" alt="" loading="lazy" decoding="async"></span>{% endif %}
          <span class="blog-corps">
            {% if a.categorie %}<span class="blog-cat">{{ a.categorie }}</span>{% endif %}
            <span class="blog-titre">{{ a.titre }}</span>
            <span class="blog-meta">{{ a.date_affichee }}{% if a.duree %} · {{ a.duree }}{% endif %}</span>
          </span>
        </a>
        {% if a.auteur %}
        <div class="blog-auteur">
          {% if a.auteur.avatar %}<img src="{{ a.auteur.avatar }}" alt="" width="30" height="30" loading="lazy" decoding="async">{% endif %}
          <span class="blog-auteur-txt">{% if a.auteur.url %}<a href="{{ a.auteur.url }}">{{ a.auteur.nom }}</a>{% else %}{{ a.auteur.nom }}{% endif %}{% if a.auteur.role %}<small>{{ a.auteur.role }}</small>{% endif %}</span>
        </div>
        {% endif %}
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- CONTACT FINAL (bloc étendu mutualisé) -->
{{ bloc_contact(site, url_page) }}
{% endmacro %}
